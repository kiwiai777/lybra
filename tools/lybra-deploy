#!/usr/bin/env bash
# lybra-deploy — isolate gate runtime from working tree (AIPOS-333)
#
# The gate (lybra-dev-gate.service) must NOT run directly from the product
# repo working tree, because agents modify that tree in real time.  This
# script creates an immutable snapshot, validates it, atomically switches
# a symlink, and restarts the gate — all as one explicit action.
#
# Usage:
#   lybra-deploy              # deploy current working tree as new release
#   lybra-deploy status       # show what version the gate is running
#   lybra-deploy rollback     # revert to previous release
#   lybra-deploy validate     # validate working tree without deploying
#
# Exit codes:
#   0  success
#   1  validation or deploy failure (old version preserved)
#   2  usage error

set -euo pipefail

# ── paths ───────────────────────────────────────────────────────────────
PRODUCT_REPO="/home/kiwi/projects/lybra"
DEPLOY_DIR="$PRODUCT_REPO/.deploy"
RELEASES_DIR="$DEPLOY_DIR/releases"
CURRENT_LINK="$DEPLOY_DIR/current"
PREVIOUS_LINK="$DEPLOY_DIR/previous"
VERSION_FILE="$DEPLOY_DIR/VERSION"
GATE_SERVICE="lybra-dev-gate.service"
MAX_RELEASES=5  # keep last N releases (oldest pruned on each deploy)

# ── AIPOS-R6S 大项B②: deploy 授权判据(缺授权即拒)──────────────────────
# 仅 verdict_ref(finalize 传本卡 PASS 裁决 id) 或 dev_override(须显式 --reason)。
DEPLOY_VERDICT_REF=""
DEPLOY_DEV_OVERRIDE=0
DEPLOY_REASON=""
DEPLOY_ACTOR=""
GOVERNANCE_ROOT=""
DEPLOY_AUTH_TYPE=""
DEPLOY_AUTH_REF=""
DEPLOY_PROVENANCE=""

parse_authorization_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verdict-ref) DEPLOY_VERDICT_REF="${2:-}"; shift 2 ;;
            --dev-override) DEPLOY_DEV_OVERRIDE=1; shift ;;
            --reason) DEPLOY_REASON="${2:-}"; shift 2 ;;
            --actor) DEPLOY_ACTOR="${2:-}"; shift 2 ;;
            --governance-root) GOVERNANCE_ROOT="${2:-}"; shift 2 ;;
            *) shift ;;
        esac
    done
}

resolve_governance_root() {
    # 从 connection.json 的 workspace_root 派生治理工作区根(单一源)。
    if [[ -n "$GOVERNANCE_ROOT" ]]; then
        return 0
    fi
    local conn_json="/home/kiwi/ai-project-os/2_projects/lybra/.lybra/connection.json"
    GOVERNANCE_ROOT=$(python3 -c "import json; print(json.load(open('$conn_json')).get('workspace_root',''))" 2>/dev/null || echo "")
    if [[ -z "$GOVERNANCE_ROOT" ]]; then
        err "Cannot resolve governance root (pass --governance-root)"
        exit 1
    fi
}

# ── rsync excludes ──────────────────────────────────────────────────────
# Things that must NOT appear in the runtime snapshot.
# Credentials (.lybra/, .env) are referenced by absolute path, never copied.
EXCLUDES=(
    ".git/"
    ".deploy/"
    ".lybra/"
    "__pycache__/"
    "*.pyc"
    "*.egg-info/"
    "task_cards/"
    "node_modules/"
    ".DS_Store"
    "._*"
    ".pytest_cache/"
    ".claude/"
    ".github/"
    ".codex/"
    ".codex"
    ".env"
    "*.tgz"
    "lybra.egg-info/"
    "playwright-report/"
    "test-results/"
)

# ── helpers ─────────────────────────────────────────────────────────────
log()  { echo "[lybra-deploy] $*"; }
err()  { echo "[lybra-deploy] ERROR: $*" >&2; }
die()  { err "$@"; exit 1; }

build_rsync_excludes() {
    local args=()
    for ex in "${EXCLUDES[@]}"; do
        args+=(--exclude="$ex")
    done
    echo "${args[@]}"
}

get_current_release_dir() {
    if [[ -L "$CURRENT_LINK" ]]; then
        readlink -f "$CURRENT_LINK"
    else
        echo ""
    fi
}

get_previous_release_dir() {
    if [[ -L "$PREVIOUS_LINK" ]]; then
        readlink -f "$PREVIOUS_LINK"
    else
        echo ""
    fi
}

read_version() {
    local dir="$1"
    if [[ -f "$dir/VERSION" ]]; then
        cat "$dir/VERSION"
    else
        echo "(unknown)"
    fi
}

# ── status ──────────────────────────────────────────────────────────────
cmd_status() {
    echo "=== lybra-deploy status ==="
    echo ""

    # Current release
    local current
    current=$(get_current_release_dir)
    if [[ -n "$current" && -d "$current" ]]; then
        echo "Running version:  $(read_version "$current")"
        echo "Running from:     $current"
    else
        echo "Running version:  (no deployment found — gate may be running from working tree)"
        echo "Running from:     (none)"
    fi
    echo ""

    # Gate service status
    if systemctl --user is-active "$GATE_SERVICE" &>/dev/null; then
        local pid
        pid=$(systemctl --user show -p MainPID --value "$GATE_SERVICE" 2>/dev/null || echo "?")
        echo "Gate service:     active (PID $pid)"
        # Show what directory the process is actually running from
        local cwd
        cwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null || echo "?")
        echo "Process cwd:      $cwd"
    else
        echo "Gate service:     inactive"
    fi
    echo ""

    # Working tree version
    local wt_hash
    wt_hash=$(cd "$PRODUCT_REPO" && git rev-parse --short HEAD 2>/dev/null || echo "(not a git repo)")
    local wt_dirty=""
    if [[ -n "$(cd "$PRODUCT_REPO" && git status --porcelain 2>/dev/null)" ]]; then
        wt_dirty=" (dirty)"
    fi
    echo "Working tree:     $wt_hash$wt_dirty"

    # List recent releases
    echo ""
    echo "Recent releases:"
    if [[ -d "$RELEASES_DIR" ]]; then
        ls -1d "$RELEASES_DIR"/*/ 2>/dev/null | tail -"$MAX_RELEASES" | while read -r d; do
            local marker=""
            [[ "$(readlink -f "$d")" == "$(get_current_release_dir)" ]] && marker=" ← current"
            [[ "$(readlink -f "$d")" == "$(get_previous_release_dir)" ]] && marker=" ← previous"
            local vinfo
            vinfo=$(head -1 "$d/VERSION" 2>/dev/null | sed 's/^release: //')
            echo "  $(basename "$d") [$vinfo]$marker"
        done
    else
        echo "  (none)"
    fi
}

# ── validate ────────────────────────────────────────────────────────────
cmd_validate() {
    local target_dir="${1:-}"
    if [[ -z "$target_dir" ]]; then
        target_dir="$PRODUCT_REPO"
    fi
    log "Validating Python import in: $target_dir"
    if (cd "$target_dir" && python3 -c "import tools.aipos_cli.aipos_cli" 2>&1); then
        log "✓ Import validation passed"
        return 0
    else
        err "✗ Import validation FAILED"
        return 1
    fi
}

# ── verify ──────────────────────────────────────────────────────────────
cmd_verify() {
    log "Verifying deployment integrity (AIPOS-369)..."
    echo ""

    # Check 1: current symlink points to HEAD
    local current_dir
    current_dir=$(get_current_release_dir)
    if [[ -z "$current_dir" || ! -d "$current_dir" ]]; then
        err "✗ No current deployment found (.deploy/current does not exist)"
        return 1
    fi

    local expected_commit current_commit
    expected_commit=$(cd "$PRODUCT_REPO" && git rev-parse HEAD 2>/dev/null || echo "unknown")
    current_commit=$(grep '^git_commit:' "$current_dir/VERSION" 2>/dev/null | awk '{print $2}' || echo "unknown")

    echo "Working tree HEAD:    $expected_commit"
    echo "Current deployment:   $current_commit"
    echo ""

    if [[ "$expected_commit" != "$current_commit" ]]; then
        err "✗ DRIFT DETECTED: .deploy/current does NOT match git HEAD"
        err "  This means the gate is running an outdated snapshot."
        err "  Run 'lybra-deploy' to fix."
        return 1
    fi
    log "✓ Symlink verification: current == HEAD"
    echo ""

    # Check 2: Live gate HTTP endpoint
    log "Querying live gate via HTTP..."
    local conn_json mcp_port executor_token
    conn_json="/home/kiwi/ai-project-os/2_projects/lybra/.lybra/connection.json"
    mcp_port=$(python3 -c "import json; print(json.load(open('$conn_json'))['mcp']['port'])" 2>/dev/null || echo "7118")
    executor_token=$(python3 -c "import json; tokens=[t for t in json.load(open('$conn_json'))['tokens'] if t.get('role')=='executor']; print(tokens[0]['token'] if tokens else '')" 2>/dev/null)

    local live_response http_status
    live_response=$(mktemp)
    http_status=$(curl -s -w "%{http_code}" -o "$live_response" -X POST "http://127.0.0.1:$mcp_port/mcp" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $executor_token" \
        -d '{
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "lybra_gate_version",
                "arguments": {}
            }
        }' 2>&1 || echo "000")

    if [[ "$http_status" != "200" ]]; then
        err "✗ Live gate HTTP endpoint unavailable (status: $http_status)"
        cat "$live_response" >&2
        rm -f "$live_response"
        return 1
    fi

    local live_commit live_runtime_dir
    live_commit=$(python3 -c "
import json, sys
try:
    data = json.load(open('$live_response'))
    result = data.get('result', {}).get('structuredContent', {})
    print(result.get('git_commit', 'unknown'))
except Exception as e:
    print('parse_error', file=sys.stderr)
    sys.exit(1)
" 2>/dev/null)
    live_runtime_dir=$(python3 -c "
import json
try:
    data = json.load(open('$live_response'))
    result = data.get('result', {}).get('structuredContent', {})
    print(result.get('runtime_directory', 'unknown'))
except Exception:
    print('unknown')
" 2>/dev/null)
    rm -f "$live_response"

    echo "Live gate commit:     $live_commit"
    echo "Live gate running from: $live_runtime_dir"
    echo ""

    if [[ "$live_commit" != "$expected_commit" ]]; then
        err "✗ LIVE GATE MISMATCH: gate is running commit $live_commit, expected $expected_commit"
        err "  The gate process has not picked up the current deployment."
        err "  Try restarting the gate service."
        return 1
    fi

    log "✓ Live gate HTTP verification: running HEAD commit"
    echo ""
    log "=== All checks passed ==="
    log "Deployment is consistent: working tree, current symlink, and live gate all at $expected_commit"
    return 0
}

# ── deploy ──────────────────────────────────────────────────────────────
cmd_deploy() {
    log "Starting deploy from working tree..."

    # ── AIPOS-R6E ①: Branch enforcement (P0) ───────────────────────────
    # Only main branch may be deployed to production gate.
    # Prevents accidental deployment of experimental/feature branches.
    local current_branch
    current_branch=$(cd "$PRODUCT_REPO" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    if [[ "$current_branch" != "main" ]]; then
        err "DEPLOY BLOCKED: Only 'main' branch may be deployed."
        err "  Current branch: $current_branch"
        err "  Required branch: main"
        err ""
        err "To deploy, first merge your changes to main:"
        err "  git checkout main"
        err "  git merge $current_branch"
        err "  lybra-deploy"
        exit 1
    fi
    log "✓ Branch check: on main"

    # ── AIPOS-R6S 大项B②: 授权判据 — 缺授权即拒 ────────────────────
    resolve_governance_root
    if [[ -n "$DEPLOY_VERDICT_REF" ]]; then
        DEPLOY_AUTH_TYPE="verdict_ref"
        DEPLOY_AUTH_REF="$DEPLOY_VERDICT_REF"
        DEPLOY_PROVENANCE="audited"
    elif [[ "$DEPLOY_DEV_OVERRIDE" == "1" ]]; then
        if [[ -z "$DEPLOY_REASON" ]]; then
            err "DEPLOY BLOCKED: --dev-override requires --reason <text> (缺授权即拒)."
            exit 1
        fi
        DEPLOY_AUTH_TYPE="dev_override"
        DEPLOY_AUTH_REF="$DEPLOY_REASON"
        DEPLOY_PROVENANCE="dev_override"
    else
        err "DEPLOY BLOCKED: deploy requires authorization (缺授权即拒)."
        err "  Authorized: lybra-deploy --verdict-ref <pass_verdict_id>"
        err "  Dev:       lybra-deploy --dev-override --reason <explicit reason>"
        exit 1
    fi
    if [[ -z "$DEPLOY_ACTOR" ]]; then
        DEPLOY_ACTOR=$(cd "$PRODUCT_REPO" && git config user.name 2>/dev/null || whoami 2>/dev/null || echo "(unknown)")
    fi
    log "✓ Authorization check: ${DEPLOY_AUTH_TYPE}=${DEPLOY_AUTH_REF} (provenance=${DEPLOY_PROVENANCE})"

    # Gather version info
    local git_hash git_timestamp
    git_hash=$(cd "$PRODUCT_REPO" && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    git_timestamp=$(date -u +"%Y%m%d_%H%M%S")

    local release_name="${git_timestamp}-${git_hash}"
    local release_dir="$RELEASES_DIR/$release_name"
    local staging_dir="$RELEASES_DIR/.staging-${release_name}"

    # Check if this exact release already exists
    if [[ -d "$release_dir" ]]; then
        die "Release $release_name already exists. Refusing to overwrite."
    fi

    # Save current for potential rollback
    local old_current
    old_current=$(get_current_release_dir)

    # ── Step 1: rsync to staging ────────────────────────────────────────
    log "Step 1/5: Creating snapshot in staging..."
    mkdir -p "$RELEASES_DIR"
    local excludes_str
    excludes_str=$(build_rsync_excludes)
    # shellcheck disable=SC2086
    rsync -a --delete \
        $excludes_str \
        "$PRODUCT_REPO/" \
        "$staging_dir/"

    # Write VERSION file into the staging release
    local dirty_flag=""
    if [[ -n "$(cd "$PRODUCT_REPO" && git status --porcelain 2>/dev/null)" ]]; then
        dirty_flag="-dirty"
    fi
    cat > "$staging_dir/VERSION" <<EOF
release: $release_name
git_commit: $(cd "$PRODUCT_REPO" && git rev-parse HEAD 2>/dev/null || echo "unknown")
git_short: ${git_hash}
built_at: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
working_tree_dirty: ${dirty_flag:-no}
deploy_script: $(readlink -f "$0")
deployment_provenance: ${DEPLOY_PROVENANCE}
authorization_type: ${DEPLOY_AUTH_TYPE}
authorization_ref: ${DEPLOY_AUTH_REF}
EOF
    log "  Snapshot created: $staging_dir"

    # ── AIPOS-C4B 大项A①: deploy 时随发布目录生成分发清单 manifest ──
    # 每个分发物 = 文件列表 + sha256 + 源 commit; gate 拉取面(gate 被动)读它。
    # 从 staging 快照构建(与将上线的内容一致), 版本戳取 VERSION.git_commit。
    log "  Building distribution manifest..."
    if (cd "$staging_dir" && python3 -m tools.distribution_manifest --repo-root "$staging_dir" --out "$staging_dir/dist/manifest.json" 2>&1); then
        log "  ✓ distribution manifest written: $staging_dir/dist/manifest.json"
    else
        log "  ⚠ distribution manifest build failed (deploy continues; gate falls back to on-the-fly build)"
    fi

    # ── Step 2: validate ────────────────────────────────────────────────
    log "Step 2/5: Validating import..."
    if ! (cd "$staging_dir" && python3 -c "import tools.aipos_cli.aipos_cli" 2>&1); then
        err "Import validation FAILED. Aborting deploy."
        err "Old version is untouched."
        rm -rf "$staging_dir"
        exit 1
    fi
    log "  ✓ Import validation passed"

    # ── Step 3: atomic symlink switch ───────────────────────────────────
    log "Step 3/5: Switching current symlink..."
    # Rename staging to final name (atomic on same filesystem)
    mv "$staging_dir" "$release_dir"

    # Save previous symlink target
    if [[ -n "$old_current" ]]; then
        ln -sfn "$old_current" "$PREVIOUS_LINK"
    fi

    # Atomic symlink switch
    ln -sfn "$release_dir" "$CURRENT_LINK"

    # Write top-level VERSION for quick inspection
    cp "$release_dir/VERSION" "$VERSION_FILE"

    log "  current → $release_dir"

    # ── AIPOS-369 S1: Mandatory assertion — current symlink == HEAD ────
    log "  Verifying current symlink points to expected release..."
    local expected_commit actual_commit_in_release
    expected_commit=$(cd "$PRODUCT_REPO" && git rev-parse HEAD 2>/dev/null || echo "unknown")
    actual_commit_in_release=$(grep '^git_commit:' "$release_dir/VERSION" | awk '{print $2}' || echo "unknown")

    if [[ "$expected_commit" == "unknown" || "$actual_commit_in_release" == "unknown" ]]; then
        err "✗ ASSERTION FAILED: Cannot determine git commits for verification."
        err "  Expected (HEAD): $expected_commit"
        err "  Release VERSION:  $actual_commit_in_release"
        err "  Deploy FAILED. Rolling back..."
        _do_rollback "$old_current"
        exit 1
    fi

    if [[ "$expected_commit" != "$actual_commit_in_release" ]]; then
        err "✗ ASSERTION FAILED: .deploy/current does NOT point to HEAD!"
        err "  Expected (git HEAD): $expected_commit"
        err "  Actual (current):    $actual_commit_in_release"
        err "  This indicates symlink switching failed silently."
        err "  Deploy FAILED. Rolling back..."
        _do_rollback "$old_current"
        exit 1
    fi
    log "  ✓ Assertion passed: current → HEAD ($expected_commit)"

    # ── Step 4: graceful handoff (AIPOS-356) ────────────────────────────
    # Zero-downtime deploy using SO_REUSEPORT:
    #   1. Start a temp MCP process with --reuse-port in its own systemd scope
    #      (isolated from the gate service's cgroup so systemctl stop won't kill it)
    #   2. Verify temp is healthy and accepting connections
    #   3. systemctl restart $GATE_SERVICE — kills old process, starts new one
    #      (new also has --reuse-port from the service file)
    #      During this: temp keeps the port alive → zero connection refused
    #   4. Wait for new systemd process to be healthy
    #   5. Kill temp scope — all traffic now goes to new process
    log "Step 4/5: Graceful handoff (AIPOS-356 — zero-downtime deploy)..."

    local service_file="$HOME/.config/systemd/user/$GATE_SERVICE"
    local conn_json="/home/kiwi/ai-project-os/2_projects/lybra/.lybra/connection.json"
    local env_file="$HOME/.config/lybra/pi-key.env"

    if [[ ! -f "$service_file" ]]; then
        err "⚠ DEGRADATION: Service file not found: $service_file"
        err "  Graceful handoff unavailable — falling back to hard restart."
        systemctl --user daemon-reload
        systemctl --user restart "$GATE_SERVICE" || { _do_rollback "$old_current"; exit 1; }
    else
        # Read MCP port from connection.json
        local mcp_host mcp_port
        mcp_host=$(python3 -c "import json; d=json.load(open('$conn_json')); print(d['mcp']['host'])" 2>/dev/null || echo "0.0.0.0")
        mcp_port=$(python3 -c "import json; d=json.load(open('$conn_json')); print(d['mcp']['port'])" 2>/dev/null || echo "7118")

        # Source env for tokens
        if [[ -f "$env_file" ]]; then
            set -a
            source "$env_file"
            set +a
        fi

        # Step 4a: Start temp MCP in its own systemd scope (isolated cgroup)
        log "  Starting temp MCP with SO_REUSEPORT in isolated scope..."
        local scope_name="lybra-deploy-handoff"
        systemd-run --user --scope --unit="$scope_name" \
            /usr/bin/python3 -m tools.mcp_server serve-http \
            --host "$mcp_host" --port "$mcp_port" \
            --service-connection-json "$conn_json" \
            --reuse-port &

        # ── AIPOS-356F1: cleanup trap for temp scope ──────────────────
        # Transient scope units don't reliably populate MainPID (337U).
        # We judge readiness by port probe (behavior), not process bookkeeping.
        # The trap ensures the temp scope is cleaned up on ANY exit path.
        local _handoff_cleanup_armed=true
        _handoff_cleanup() {
            if [[ "${_handoff_cleanup_armed:-}" == "true" ]]; then
                log "  [cleanup] Stopping temp handoff scope ($scope_name.scope)..."
                systemctl --user stop "$scope_name.scope" 2>/dev/null || true
                _handoff_cleanup_armed=false
            fi
        }
        trap '_handoff_cleanup' EXIT ERR INT TERM

        # ── AIPOS-356F1: port-based readiness (replaces MainPID check) ─
        # Wait for the temp MCP to accept TCP connections.
        # This is the single source of truth — no MainPID dependency.
        log "  Waiting for temp MCP to accept connections (port probe)..."
        local max_wait=15 waited=0 ready=false
        while (( waited < max_wait )); do
            if python3 -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.5)
try:
    s.connect(('127.0.0.1', $mcp_port))
    s.close()
except Exception:
    sys.exit(1)
" 2>/dev/null; then
                ready=true
                break
            fi
            sleep 0.5
            (( waited++ )) || true
        done

        if [[ "$ready" != "true" ]]; then
            # ── DEGRADATION: temp never became ready ──
            err "⚠ DEGRADATION: Temp MCP did not become ready within ${max_wait}s"
            err "  Graceful handoff failed — falling back to hard restart."
            err "  (Temp scope will be cleaned up by trap)"
            # trap handles temp scope cleanup; proceed with hard restart
            systemctl --user daemon-reload
            systemctl --user restart "$GATE_SERVICE" || { _do_rollback "$old_current"; exit 1; }
        else
            log "  ✓ Temp MCP is accepting connections (port probe passed)"

            # Step 4c: Restart the gate service.
            # systemd stops old (SIGTERM to cgroup) → starts new (from new symlink).
            # The temp scope is NOT in the service's cgroup, so it survives.
            # Both temp + new have SO_REUSEPORT → port always has a listener.
            log "  Restarting gate service (temp keeps port alive)..."
            systemctl --user daemon-reload
            systemctl --user restart "$GATE_SERVICE"

            # Step 4d: Wait for the new systemd process to be healthy
            log "  Waiting for new gate process to stabilize..."
            sleep 3
            local new_ready=false
            for i in $(seq 1 10); do
                if systemctl --user is-active "$GATE_SERVICE" &>/dev/null; then
                    # Verify the new process is actually responding
                    if python3 -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.5)
try:
    s.connect(('127.0.0.1', $mcp_port))
    s.close()
except Exception:
    sys.exit(1)
" 2>/dev/null; then
                        new_ready=true
                        break
                    fi
                fi
                sleep 1
            done

            # Step 4e: Handoff complete — disarm trap, then kill temp scope
            _handoff_cleanup_armed=false
            trap - EXIT ERR INT TERM
            log "  Stopping temp handoff scope..."
            systemctl --user stop "$scope_name.scope" 2>/dev/null || true

            if [[ "$new_ready" != "true" ]]; then
                err "New gate process did not become ready!"
                err "Rolling back..."
                _do_rollback "$old_current"
                exit 1
            fi
            log "  ✓ Graceful handoff complete — new gate is serving"
        fi
    fi

    # ── Step 5: health check ────────────────────────────────────────────
    log "Step 5/5: Health check (verifying gate stability + live endpoint)..."
    sleep 2

    if ! systemctl --user is-active "$GATE_SERVICE" &>/dev/null; then
        err "Gate failed to stay running after restart! Rolling back..."
        _do_rollback "$old_current"
        exit 1
    fi

    # ── AIPOS-369 S2: Live gate endpoint verification ──────────────────
    log "  Verifying live gate is running the deployed commit..."
    local mcp_port conn_json executor_token expected_commit
    conn_json="/home/kiwi/ai-project-os/2_projects/lybra/.lybra/connection.json"
    mcp_port=$(python3 -c "import json; print(json.load(open('$conn_json'))['mcp']['port'])" 2>/dev/null || echo "7118")
    executor_token=$(python3 -c "import json; tokens=[t for t in json.load(open('$conn_json'))['tokens'] if t.get('role')=='executor']; print(tokens[0]['token'] if tokens else '')" 2>/dev/null)
    expected_commit=$(cd "$PRODUCT_REPO" && git rev-parse HEAD 2>/dev/null || echo "unknown")

    local live_commit live_response http_status
    live_response=$(mktemp)
    http_status=$(curl -s -w "%{http_code}" -o "$live_response" -X POST "http://127.0.0.1:$mcp_port/mcp" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $executor_token" \
        -d '{
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {
                "name": "lybra_gate_version",
                "arguments": {}
            }
        }' 2>&1 || echo "000")

    if [[ "$http_status" != "200" ]]; then
        # Check if it's "Unknown tool" error (old gate without lybra_gate_version)
        local error_msg
        error_msg=$(python3 -c "
import json, sys
try:
    data = json.load(open('$live_response'))
    error = data.get('error', {})
    print(error.get('message', ''))
except Exception:
    print('')
" 2>/dev/null)
        
        if [[ "$error_msg" == *"Unknown tool"* ]]; then
            log "  ⚠ DEGRADATION: lybra_gate_version tool not available (old gate)"
            log "  Live HTTP verification skipped — only Step 3 assertion applies."
            log "  After this deploy, future deploys will have full HTTP verification."
            rm -f "$live_response"
        else
            err "✗ Live gate HTTP endpoint failed (status: $http_status)"
            cat "$live_response" >&2
            rm -f "$live_response"
            err "Deploy technically succeeded but live verification failed."
            err "Manual inspection required."
            exit 1
        fi
    else
        # HTTP 200 — parse and verify commit
        live_commit=$(python3 -c "
import json, sys
try:
    data = json.load(open('$live_response'))
    result = data.get('result', {}).get('structuredContent', {})
    print(result.get('git_commit', 'unknown'))
except Exception:
    print('parse_error')
" 2>/dev/null)
        rm -f "$live_response"

        if [[ "$live_commit" == "unknown" || "$live_commit" == "parse_error" ]]; then
            err "✗ Could not parse live gate version from HTTP response."
            err "Deploy technically succeeded but live verification failed."
            err "Manual inspection required."
            exit 1
        fi

        if [[ "$live_commit" != "$expected_commit" ]]; then
            err "✗ DEPLOYMENT VERIFICATION FAILED!"
            err "  Expected (git HEAD): $expected_commit"
            err "  Live gate reports:   $live_commit"
            err "  The gate restarted but is NOT running the new code."
            err "  This should not happen after Step 3 assertion passed."
            err "  Manual inspection required."
            exit 1
        fi

        log "  ✓ Live gate HTTP endpoint verified: running commit $live_commit"
    fi
    log ""
    log "✓ Deploy successful and VERIFIED live!"
    log ""
    log "Deployed version: $release_name"
    log "  git commit: $expected_commit"
    log "  running from: $release_dir"
    log "  live gate confirmed via HTTP: YES"
    if [[ -n "$dirty_flag" ]]; then
        log "  ⚠ Working tree was dirty at deploy time"
    fi

    # ── AIPOS-R6S 大项B①: 落 deployment_record(commit/actor/时间/authorization)──
    log "Writing deployment_record..."
    local rec_cmd=(
        python3 -m tools.aipos_cli.deployment_record
        --governance-root "$GOVERNANCE_ROOT"
        --commit "$(cd "$PRODUCT_REPO" && git rev-parse HEAD)"
        --actor "$DEPLOY_ACTOR"
        --runtime-directory "$release_dir"
    )
    if [[ "$DEPLOY_AUTH_TYPE" == "verdict_ref" ]]; then
        rec_cmd+=(--verdict-ref "$DEPLOY_AUTH_REF")
    else
        rec_cmd+=(--dev-override --reason "$DEPLOY_AUTH_REF")
    fi
    if (cd "$PRODUCT_REPO" && "${rec_cmd[@]}" 2>&1); then
        log "  ✓ deployment_record written"
    else
        log "  ⚠ deployment_record write failed (deploy itself succeeded)"
    fi

    # ── Prune old releases ──────────────────────────────────────────────
    _prune_releases

    log ""
    log "Done. Gate is serving from isolated snapshot."
}

# ── rollback ────────────────────────────────────────────────────────────
_do_rollback() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target=$(get_previous_release_dir)
    fi
    if [[ -z "$target" || ! -d "$target" ]]; then
        err "No previous release to roll back to!"
        err "Manual intervention required."
        return 1
    fi
    log "Rolling back to: $target"
    ln -sfn "$target" "$CURRENT_LINK"
    cp "$target/VERSION" "$VERSION_FILE" 2>/dev/null || true
    systemctl --user restart "$GATE_SERVICE" || true
    sleep 3
    if systemctl --user is-active "$GATE_SERVICE" &>/dev/null; then
        log "✓ Rollback successful. Gate running from: $target"
    else
        err "Rollback completed but gate is not running. Manual intervention needed."
    fi
}

cmd_rollback() {
    local prev
    prev=$(get_previous_release_dir)
    if [[ -z "$prev" || ! -d "$prev" ]]; then
        die "No previous release available for rollback."
    fi
    log "Will roll back to: $(read_version "$prev")"
    log "Target: $prev"
    _do_rollback "$prev"
}

# ── prune ───────────────────────────────────────────────────────────────
_prune_releases() {
    local count
    count=$(ls -1d "$RELEASES_DIR"/*/ 2>/dev/null | wc -l)
    if (( count > MAX_RELEASES )); then
        local to_remove=$(( count - MAX_RELEASES ))
        log "Pruning $to_remove old release(s)..."
        ls -1d "$RELEASES_DIR"/*/ 2>/dev/null | head -n "$to_remove" | while read -r old; do
            local resolved
            resolved=$(readlink -f "$old")
            # Never prune current or previous
            if [[ "$resolved" == "$(get_current_release_dir)" || "$resolved" == "$(get_previous_release_dir)" ]]; then
                continue
            fi
            rm -rf "$old"
            log "  Removed: $(basename "$old")"
        done
    fi
}

# ── main ────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-deploy}"
    shift 2>/dev/null || true
    # AIPOS-R6S 大项B②: 解析授权参数(仅 deploy 需要; status/rollback/verify 忽略)
    parse_authorization_args "$@"

    case "$cmd" in
        deploy)    cmd_deploy ;;
        status)    cmd_status ;;
        rollback)  cmd_rollback ;;
        validate)  cmd_validate "$@" ;;
        verify)    cmd_verify ;;
        -h|--help|help)
            echo "Usage: lybra-deploy [command] [authorization]"
            echo ""
            echo "Commands:"
            echo "  deploy     (default) Snapshot working tree, validate, switch, restart gate"
            echo "  status     Show current deployed version and gate status"
            echo "  rollback   Revert to previous release"
            echo "  validate   Check if working tree can be imported (no deploy)"
            echo "  verify     Verify deployment integrity: current==HEAD + live gate HTTP check (AIPOS-369)"
            echo ""
            echo "Authorization (deploy only, REQUIRED — AIPOS-R6S 大项B② 缺授权即拒):"
            echo "  --verdict-ref <id>   Audited deploy: PASS audit verdict id (deployment_provenance=audited)"
            echo "  --dev-override       Unaudited dev deploy (deployment_provenance=dev_override)"
            echo "  --reason <text>      Required when using --dev-override"
            echo "  --actor <name>       Deploying actor (default: git user.name)"
            echo "  --governance-root <p>  Governance workspace root (default: from connection.json)"
            echo ""
            echo "AIPOS-333: gate runtime isolation from working tree."
            echo "AIPOS-369: deployment integrity verification."
            echo "AIPOS-R6S: deployment authorization + deployment_record."
            ;;
        *)
            err "Unknown command: $cmd"
            echo "Usage: lybra-deploy [deploy|status|rollback|validate|verify] [--verdict-ref|--dev-override ...]" >&2
            exit 2
            ;;
    esac
}

main "$@"
