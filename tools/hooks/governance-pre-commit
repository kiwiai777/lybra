#!/usr/bin/env bash
# AIPOS-R6M 大项B + AIPOS-A1 大项A③: 治理仓 pre-commit 钩子(文件面护栏)
#   ① 代码文件禁止 (R6A 靶子⑨)
#   ② 治理决策类 .md 无状态头 frontmatter → 拒并给模板 (格式规则从声明读)
#   ③ decision_log/ append-only (只许新增禁修改)
#   ④ 5_tasks/records/** 新增文件必须携机器出生标记 (record_type)
#
# AIPOS-R6M FIX-1: 路径定义从 config.schema 治理目录树读(单一源),
#   仓内相对前缀动态计算(治理仓 git 根 ≠ 治理工作区根时, 如 2_projects/lybra/,
#   不再写死 ^governance/ 前缀)。
#
# AIPOS-A1 大项A③: 格式规则(必填 frontmatter 字段)从
#   config.schema governance_structure.file_declarations 读取,
#   产生侧(CLI)与出口侧(hook)共用同一份声明。改一处两侧跟随。

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ---- 单一源: config.schema (LYBRA_SCHEMA_DIR 可覆盖默认产品仓) ----
SCHEMA_DIR="${LYBRA_SCHEMA_DIR:-$HOME/projects/lybra/schema}"
CONFIG_SCHEMA="$SCHEMA_DIR/config.schema.json"
if [ ! -f "$CONFIG_SCHEMA" ]; then
    echo "❌ BLOCKED: config.schema not found at $CONFIG_SCHEMA (single source unavailable; set LYBRA_SCHEMA_DIR)"
    exit 1
fi

# ---- 从 config.schema 解析治理目录树路径 + 文件声明 + 定位治理工作区根 + 输出给 bash ----
eval "$(python3 - "$REPO_ROOT" "$CONFIG_SCHEMA" <<'PY'
import json, os, sys

repo_root, schema_path = sys.argv[1], sys.argv[2]
d = json.load(open(schema_path))
gs = d.get("governance_structure", {}) or {}
paths = gs.get("paths", {}) or {}
file_decls = gs.get("file_declarations", {}) or {}

def rel(key, default):
    return str((paths.get(key) or {}).get("path") or default).strip("/")

gov_docs = rel("governance_docs", "governance")
decision_log = rel("decision_log_dir", "governance/decision_log")
tasks_root = rel("tasks_root", "5_tasks")
records = rel("records", "records")
records_full = f"{tasks_root}/{records}".strip("/")

# AIPOS-A1: 从 file_declarations 读取各类文件的必填 frontmatter 字段
def get_required_fm(decl_key):
    decl = file_decls.get(decl_key, {}) or {}
    fields = decl.get("required_frontmatter", []) or []
    return "|".join(fields)

gov_doc_fm = get_required_fm("governance_doc")
record_fm = get_required_fm("record_file")

# 治理工作区根 = repo_root 下同时含 gov_docs 首段 与 tasks_root 首段 的目录
gov_seg = gov_docs.split("/")[0]
tasks_seg = tasks_root.split("/")[0]
ws_root = repo_root
for dirpath, dirnames, filenames in os.walk(repo_root):
    depth = dirpath[len(repo_root.rstrip('/')):].count(os.sep)
    dirnames[:] = [x for x in dirnames if x not in (".git", "node_modules")]
    if depth >= 4:
        dirnames[:] = []
        continue
    if os.path.isdir(os.path.join(dirpath, gov_seg)) and os.path.isdir(os.path.join(dirpath, tasks_seg)):
        ws_root = dirpath
        break

def sh(s):
    return "'" + s.replace("'", "'\\''") + "'"

print(f"GOV_WS_ROOT={sh(ws_root)}")
print(f"GOV_DOCS_REL={sh(gov_docs)}")
print(f"DECISION_LOG_REL={sh(decision_log)}")
print(f"RECORDS_REL={sh(records_full)}")
print(f"GOV_DOC_REQUIRED_FM={sh(gov_doc_fm)}")
print(f"RECORD_REQUIRED_FM={sh(record_fm)}")
PY
)"

# ---- 仓内相对前缀(动态计算, 不写死) ----
if [ "$GOV_WS_ROOT" = "$REPO_ROOT" ]; then
    PREFIX=""
else
    PREFIX="${GOV_WS_ROOT#"$REPO_ROOT"/}/"
fi

GOV_DOCS_PREFIX="${PREFIX}${GOV_DOCS_REL}/"
DECISION_LOG_PREFIX="${PREFIX}${DECISION_LOG_REL}/"
RECORDS_PREFIX="${PREFIX}${RECORDS_REL}/"

echo "🔍 AIPOS-R6M: governance guardrails (ws_prefix=${PREFIX:-<repo-root>/})"

# 代码文件扩展名黑名单 (大项B①, 保留 R6A)
CODE_EXTENSIONS=(py js ts tsx jsx java go rs c cpp sh bash rb php swift)

blocked_files=()
blocked_reasons=()

# 文件是否以某仓内相对前缀开头(前缀动态, 非写死 ^governance/)
under_prefix() {
    case "$1" in
        "$2"*) return 0 ;;
        *) return 1 ;;
    esac
}

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"

if [ -z "$staged_files" ]; then
    echo "✅ No files to check."
    exit 0
fi

# 大项B①: 代码文件禁止
while IFS= read -r file; do
    [ -z "$file" ] && continue
    [ ! -f "$file" ] && continue
    extension="${file##*.}"
    for ext in "${CODE_EXTENSIONS[@]}"; do
        if [ "$extension" = "$ext" ]; then
            blocked_files+=("$file")
            blocked_reasons+=("Code file forbidden in governance repo (B①)")
            break
        fi
    done
done <<< "$staged_files"

# 大项B②: 治理决策类 .md 需 frontmatter (必填字段从 file_declarations 声明读取)
# AIPOS-A1: 必填字段列表来自 GOV_DOC_REQUIRED_FM (config.schema governance_structure.file_declarations.governance_doc.required_frontmatter)
IFS='|' read -ra GOV_DOC_FM_FIELDS <<< "$GOV_DOC_REQUIRED_FM"
while IFS= read -r file; do
    [ -z "$file" ] && continue
    [ ! -f "$file" ] && continue
    if under_prefix "$file" "$GOV_DOCS_PREFIX" && [[ "$file" == *.md ]]; then
        if ! grep -q '^---$' "$file" 2>/dev/null; then
            blocked_files+=("$file")
            blocked_reasons+=("Missing frontmatter (B②, required: ${GOV_DOC_REQUIRED_FM})")
            continue
        fi
        frontmatter=$(awk 'BEGIN{n=0} /^---$/{n++; next} {if(n==1) print}' "$file")
        for fm_field in "${GOV_DOC_FM_FIELDS[@]}"; do
            [ -z "$fm_field" ] && continue
            if ! printf '%s\n' "$frontmatter" | grep -q "^${fm_field}:"; then
                blocked_files+=("$file")
                blocked_reasons+=("Missing '${fm_field}' field in frontmatter (B②, declared in config.schema file_declarations.governance_doc)")
            fi
        done
    fi
done <<< "$staged_files"

# 大项B③: decision_log/ append-only (禁修改, 只许新增)
while IFS= read -r file; do
    [ -z "$file" ] && continue
    if under_prefix "$file" "$DECISION_LOG_PREFIX"; then
        blocked_files+=("$file")
        blocked_reasons+=("decision_log/ is append-only, modifications forbidden (B③)")
    fi
done < <(git diff --cached --name-only --diff-filter=M)

# 大项B④: records/** 新增文件必须携机器出生标记 (必填字段从 file_declarations 声明读取)
# AIPOS-A1: 必填字段列表来自 RECORD_REQUIRED_FM (config.schema governance_structure.file_declarations.record_file.required_frontmatter)
IFS='|' read -ra RECORD_FM_FIELDS <<< "$RECORD_REQUIRED_FM"
while IFS= read -r file; do
    [ -z "$file" ] && continue
    [ ! -f "$file" ] && continue
    if under_prefix "$file" "$RECORDS_PREFIX"; then
        for fm_field in "${RECORD_FM_FIELDS[@]}"; do
            [ -z "$fm_field" ] && continue
            if ! grep -q "^${fm_field}:" "$file" 2>/dev/null; then
                blocked_files+=("$file")
                blocked_reasons+=("New record lacks required field '${fm_field}' (B④, declared in config.schema file_declarations.record_file)")
            fi
        done
    fi
done < <(git diff --cached --name-only --diff-filter=A)

if [ ${#blocked_files[@]} -gt 0 ]; then
    echo ""
    echo "❌ BLOCKED: Governance repo commit violates AIPOS-R6M file-level guardrails"
    echo ""
    echo "Violations:"
    for i in "${!blocked_files[@]}"; do
        echo "  - ${blocked_files[$i]}: ${blocked_reasons[$i]}"
    done
    echo ""
    echo "Guardrails (AIPOS-R6M 大项B + AIPOS-A1 声明驱动):"
    echo "  ① Code files forbidden in governance repo"
    echo "  ② Governance docs require frontmatter with declared fields:"
    echo "     Required fields (from config.schema file_declarations.governance_doc): ${GOV_DOC_REQUIRED_FM}"
    echo "     ---"
    echo "     status: active"
    echo "     ---"
    echo "  ③ decision_log/ is append-only (modifications forbidden)"
    echo "  ④ New records require declared fields (from config.schema file_declarations.record_file): ${RECORD_REQUIRED_FM}"
    echo ""
    exit 1
fi

echo "✅ All governance guardrails passed. Commit allowed."
exit 0
