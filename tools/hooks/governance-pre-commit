#!/usr/bin/env bash
# AIPOS-R6M 大项B + AIPOS-A1 大项A③ + AIPOS-F29 大项C + AIPOS-F79D 件①②: 治理仓 pre-commit 钩子(文件面护栏)
#   ① 代码文件禁止 (R6A 靶子⑨; 声明 config.schema code_files_blacklist)
#   ② 治理决策类 .md 无状态头 frontmatter → 拒并给模板 (格式规则从声明读)
#   ③ decision_log/ append-only (只许新增禁修改)
#   ④ 5_tasks/records/** 新增文件必须携机器出生标记 (record_type)
#   ⑤ 治理仓 HEAD 必须是 main 分支 (F29: 执行体禁把卡分支开进治理仓)
#
# AIPOS-F79D 件①: 四检规则只有一份实现 —— tools/aipos_cli/governance_guardrails.py。
#   本壳只做两件事: 取 staged 清单(统一读取层, core.quotepath=false + -z) 并调用该模块。
#   `lybra governance-commit`(含 --dry-run)对同一「将提交清单」调同一模块, 拒因文案同源。
# AIPOS-F79D 件②: 治理工作区根按 staged 文件各自归属判(模块内实现), 不再 os.walk 首命中。
# AIPOS-F6: 读取层统一禁用 quotepath 转义; 自检失败 → hook 自身拒绝放行(护栏禁静默降级)。

set -e
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ---- 单一源: config.schema (LYBRA_SCHEMA_DIR 可覆盖默认产品仓) ----
SCHEMA_DIR="${LYBRA_SCHEMA_DIR:-$HOME/projects/lybra/schema}"
CONFIG_SCHEMA="$SCHEMA_DIR/config.schema.json"
if [ ! -f "$CONFIG_SCHEMA" ]; then
    echo "❌ BLOCKED: config.schema not found at $CONFIG_SCHEMA (single source unavailable; set LYBRA_SCHEMA_DIR)"
    exit 1
fi
PRODUCT_ROOT="$(cd "$SCHEMA_DIR/.." && pwd)"
GUARDRAILS_MODULE="$PRODUCT_ROOT/tools/aipos_cli/governance_guardrails.py"
if [ ! -f "$GUARDRAILS_MODULE" ]; then
    echo "❌ BLOCKED: guardrails module not found at $GUARDRAILS_MODULE (product repo beside schema dir required)"
    exit 1
fi

# ---- 统一读取层 (AIPOS-F6): 所有 git 路径枚举必须经此函数, 强制 core.quotepath=false + -z ----
git_staged_name_status() {
    local dir="${1:-.}"
    git -C "$dir" -c core.quotepath=false diff --cached --name-status --no-renames -z
}

# ---- 自检 (AIPOS-F6 靶②, C2: 护栏禁静默降级) ----
# 用同一读取函数在临时仓枚举非 ASCII 文件, 必须原样输出(未被 quotepath 转义)。失败即拒绝放行。
self_test_nonascii() {
    local sample="决策日志_非ASCII自检.md"
    local tmpd out
    tmpd="$(mktemp -d 2>/dev/null)"
    if [ -z "$tmpd" ] || [ ! -d "$tmpd" ]; then
        echo "❌ BLOCKED: hook self-test 无法创建临时目录(mktemp 失败)。拒绝放行。"
        return 1
    fi
    if ! git -C "$tmpd" init -q 2>/dev/null; then
        rm -rf "$tmpd"
        echo "❌ BLOCKED: hook self-test 无法初始化临时仓(git init 失败)。拒绝放行。"
        return 1
    fi
    printf 'x\n' > "$tmpd/$sample"
    if ! git -C "$tmpd" add -- "$sample" 2>/dev/null; then
        rm -rf "$tmpd"
        echo "❌ BLOCKED: hook self-test 无法暂存非 ASCII 样例(git add 失败)。拒绝放行。"
        return 1
    fi
    out="$(git_staged_name_status "$tmpd" 2>/dev/null | tr '\0' '\n' || true)"
    rm -rf "$tmpd"
    if ! printf '%s\n' "$out" | grep -qF "$sample"; then
        echo "❌ BLOCKED: hook self-test FAILED — git 读取层对非 ASCII 路径输出了转义形式(core.quotepath 未禁用), 护栏被击穿。拒绝放行。"
        return 1
    fi
    return 0
}

if ! self_test_nonascii; then
    exit 1
fi

# ---- 四检: staged 清单 → 单源模块(规则/文案在模块内; 非零即拒) ----
if ! git_staged_name_status "$REPO_ROOT" \
    | PYTHONPATH="$PRODUCT_ROOT" python3 -m tools.aipos_cli.governance_guardrails \
        --repo-root "$REPO_ROOT" --schema-dir "$SCHEMA_DIR" --staged-stdin; then
    exit 1
fi
exit 0
