#!/usr/bin/env bash
# AIPOS-F73B件③: 审计体工位无参一词命令
# 
# 功能: 启动只问产品「我这个实例名下已认领的卡是哪张」，取工作树与报告落点，
#       把会话 cwd 切入工作树后开工；无认领卡=提示等待并退出。
# 
# 源码母本住产品仓 agents/harness/pi/，由 lybra sync 分发到工位。
# 带参 /claim <路径> 在 lybra 三工位退役（人肉 gate 项目由其声明保留）。
# 
# 租约/心跳/调度一概不做。单次查询，无循环，无常驻。

set -euo pipefail

# 读取工位配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSTATION_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 从 .lybra/role 读取 agent_instance
if [[ ! -f "$WORKSTATION_ROOT/.lybra/role" ]]; then
    echo "Error: .lybra/role not found. Run 'lybra enroll' first." >&2
    exit 1
fi

AGENT_INSTANCE=$(jq -r '.agent_instance // .role // empty' "$WORKSTATION_ROOT/.lybra/role" 2>/dev/null || echo "")
if [[ -z "$AGENT_INSTANCE" ]]; then
    echo "Error: Cannot determine agent_instance from .lybra/role" >&2
    exit 1
fi

# 从 .lybra/connection.json 读取 workspace_root 和 lybra_bin
if [[ ! -f "$WORKSTATION_ROOT/.lybra/connection.json" ]]; then
    echo "Error: .lybra/connection.json not found. Run 'lybra enroll' first." >&2
    exit 1
fi

WORKSPACE_ROOT=$(jq -r '.workspace_root // empty' "$WORKSTATION_ROOT/.lybra/connection.json" 2>/dev/null || echo "")
LYBRA_BIN=$(jq -r '.lybra_bin // empty' "$WORKSTATION_ROOT/.lybra/connection.json" 2>/dev/null || echo "")

if [[ -z "$WORKSPACE_ROOT" ]]; then
    echo "Error: workspace_root not found in .lybra/connection.json" >&2
    exit 1
fi

if [[ -z "$LYBRA_BIN" ]] || [[ ! -x "$LYBRA_BIN" ]]; then
    echo "Error: lybra_bin not found or not executable in .lybra/connection.json" >&2
    exit 1
fi

# 查询本实例已认领的卡
# 使用 lybra next 推导（按 agent_instance 过滤）
# AIPOS-F73B: next 的推导核按 agent_instance 过滤已认领卡
DERIVATION=$("$LYBRA_BIN" next --task-id="" --json 2>/dev/null | jq -r --arg instance "$AGENT_INSTANCE" '
    select(.current_state == "claimed" and (.claimed_by == $instance or .agent_instance == $instance))
    | .task_id
' || echo "")

if [[ -z "$DERIVATION" ]]; then
    echo "No claimed task for instance $AGENT_INSTANCE. Waiting for task assignment..." >&2
    exit 0
fi

TASK_ID="$DERIVATION"

# 推导 worktree 路径（按 distribution.schema 声明的 card/<ID> 模式）
WORKTREE_PATH="$WORKSPACE_ROOT/card/$TASK_ID"

if [[ ! -d "$WORKTREE_PATH" ]]; then
    echo "Error: Worktree not found at $WORKTREE_PATH. Run 'lybra next --run' to claim and create worktree." >&2
    exit 1
fi

# 推导报告落点（治理仓 task_cards/<ID>/）
REPORT_DIR="$WORKSPACE_ROOT/task_cards/$TASK_ID"
mkdir -p "$REPORT_DIR"

# 切换到 worktree 并输出位置信息
cd "$WORKTREE_PATH"

echo "=== Auditor workstation ready ==="
echo "Task ID: $TASK_ID"
echo "Worktree: $WORKTREE_PATH"
echo "Branch: $(git branch --show-current 2>/dev/null || echo 'unknown')"
echo "Report directory: $REPORT_DIR"
echo ""
echo "Ready to audit. Write your VERDICT-$TASK_ID.md to $REPORT_DIR/ when done."
echo "=================================="

# 启动 pi（如果在 pi 环境中）
# 注意：这里不直接调用 pi，而是输出信息让用户/调度器决定下一步
# 真正的会话启动由扣扳机方（Owner 或调度器）处理

exec bash
