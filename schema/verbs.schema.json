{
  "schema_version": "2.1.0",
  "description": "Lybra verb contracts — single source of truth for gate tool names, parameter shapes, two-phase (dry_run → confirm) semantics, stage contracts, preconditions, and response field derivation. CLI, MCP, manual, and response hints are ALL projections of this file. No handwritten second source.",
  "last_updated": "2026-08-19",
  "source_of_truth": "This file is the ONLY place a connector may learn a verb name, parameter shape, stage contract, or response field derivation. CLI subcommands, MCP response fields, and advisor manual verb references are generated from this file. No handwritten per-verb wrappers anywhere.",
  "aipos_c1": {
    "purpose": "AIPOS-C1: verbs.schema as the single truth for the verb surface. CLI/MCP/manual/response-hints are four projections.",
    "projections": {
      "cli": "tools/aipos_cli/aipos_cli.py — queue subcommands derived from verbs with surface=cli or phase declarations",
      "mcp_response": "tools/mcp_server/tools.py — owner_confirmation_required and client_hint derived from stage_contract.self_confirm_allowed",
      "manual": "tools/generate_advisor_commands.py — ADVISOR-COMMANDS verb reference section generated from this schema",
      "assertion": "tools/test_aipos_c1_surface_consistency.py — validates all projections match this schema"
    }
  },
  "two_phase_protocol": {
    "description": "Mutation verbs follow dry_run → confirm two-phase pattern. dry_run previews without side effects and (for claim/return) returns a dry_run_token; confirm executes.",
    "phases": {
      "dry_run": {
        "purpose": "Preview operation without side effects",
        "returns": "Operation plan, validation results, and (for claim/return) dry_run_token for confirmation"
      },
      "confirm": {
        "purpose": "Execute the operation",
        "requires": "claim/return: valid dry_run_token from the dry_run phase. close: replays task_id + actor + closure_evidence (no dry_run_token)."
      }
    }
  },
  "warn_behavior": {
    "description": "WARN behavior contract - consistent across all verbs",
    "rules": [
      "WARN is non-blocking - operation proceeds with warnings",
      "WARN never consumes tokens - dry_run_token remains valid",
      "WARN never blocks subsequent operations",
      "WARN messages are recorded but do not prevent confirmation",
      "Executor can proceed through WARN to completion"
    ]
  },
  "response_field_derivation": {
    "description": "Rules for deriving MCP response fields from stage_contract. Single source — no handwritten conditionals in tools.py.",
    "rules": {
      "owner_confirmation_required": "true if stage_contract.self_confirm_allowed is empty (no one can self-confirm); false otherwise",
      "client_hint": "Generated from stage_contract.self_confirm_allowed: if non-empty, hint says 'self-confirm allowed with OWNER_CONFIRMED literal'; if empty, hint says 'owner must confirm via owner scope'",
      "dry_run_token_emitted": "true if stage_contract.dry_run_emits_token is true"
    }
  },
  "verbs": {
