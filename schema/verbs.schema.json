    "lybra_mark_concluded": {
      "description": "Mark a task as concluded (bypass path for report-style audits). AIPOS-C1: precondition = target card must NOT have a formal verdict; if it does, refuse and point to lybra_queue_close.",
      "phase": "single",
      "surface": ["cli", "mcp"],
      "cli_command": "lybra converge mark-concluded",
      "stage_contract": {
        "two_stage": false,
        "dry_run_emits_token": false,
        "self_confirm_allowed": [],
        "owner_confirmation_required_in_response": false
      },
      "preconditions": [
        {
          "id": "no_formal_verdict",
          "description": "Target card must NOT have a formal audit verdict (PASS/PASS_WITH_NOTES/FAIL/BLOCK). If a formal verdict exists, the card must be closed via lybra_queue_close, not mark-concluded.",
          "on_violation": "reject_with_redirect",
          "redirect_verb": "lybra_queue_close_dry_run",
          "redirect_hint": "Task {task_id} has a formal verdict ({verdict}). Use 'lybra queue close' instead of mark-concluded."
        }
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task ID to mark concluded" },
          "actor": { "type": "string", "description": "Actor marking concluded" },
          "report_path": { "type": "string", "description": "Report path (optional)" },
          "conclusion_note": { "type": "string", "description": "Conclusion note (optional)" },
          "dry_run": { "type": "boolean", "description": "Preview without writing" }
        },
        "required": ["task_id"],
        "additionalProperties": false
      }
    },
    "lybra_audit_dispatch_dry_run": {
      "description": "Dispatch an audit (preview). AIPOS-C1: idempotent — if audit card already exists, supplements dispatch record instead of blocking.",
      "phase": "dry_run",
      "base_verb": "lybra_audit_dispatch",
      "confirm_verb": "lybra_audit_dispatch_confirm",
      "confirm_via": "dry_run_token",
      "surface": ["cli", "mcp"],
      "cli_command": "lybra audit dispatch",
      "stage_contract": {
        "two_stage": true,
        "dry_run_emits_token": true,
        "self_confirm_allowed": ["advisor_with_owner_confirmed_literal"],
        "self_confirm_mechanism": "AIPOS-328: advisor/auditor self-confirm with OWNER_CONFIRMED literal",
        "owner_confirmation_required_in_response": false,
        "client_hint_template": "AIPOS-328: advisor/auditor自行confirm。使用 lybra_audit_dispatch_confirm 带上 dry_run_token 与 owner_confirmation_token='OWNER_CONFIRMED'(字面常量,非秘密)。Owner不需参与此步骤。"
      },
      "preconditions": [
        {
          "id": "audit_idempotent",
          "description": "If the audit task card already exists (AUDIT_TASK_ID_EXISTS), supplement the dispatch record instead of blocking. The dispatch is idempotent — re-dispatching for the same source+audit pair updates the dispatch record.",
          "on_violation": "idempotent_supplement",
          "supplement_action": "update_dispatch_record_and_proceed"
        }
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "source_task_id": { "type": "string", "description": "Task being audited" },
          "source_path": { "type": "string", "description": "Task path (alternative to source_task_id)" },
          "actor": { "type": "string", "description": "Dispatching actor" },
          "agent_instance": { "type": "string", "description": "Dispatching agent instance" },
          "owner_policy_ref": { "type": "string", "description": "Owner policy reference" },
          "audit_task_id": { "type": "string", "description": "Audit task identifier" },
          "audit_task_title": { "type": "string", "description": "Audit task title" },
          "audit_by": { "type": "string", "description": "Auditor agent" },
          "audit_agent_instance": { "type": "string", "description": "Auditor agent instance" },
          "dispatch_reason": { "type": "string", "description": "Reason for dispatch" }
        },
        "required": ["actor", "agent_instance", "owner_policy_ref", "audit_task_id", "audit_agent_instance"],
        "additionalProperties": false
      }
    }
  }
