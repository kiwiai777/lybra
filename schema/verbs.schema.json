    "lybra_queue_claim_dry_run": {
      "description": "Claim a pending task (preview; PreAuthorized may release in one phase).",
      "phase": "dry_run",
      "base_verb": "lybra_queue_claim",
      "confirm_verb": "lybra_queue_claim_confirm",
      "confirm_via": "dry_run_token",
      "surface": ["cli", "mcp"],
      "cli_command": "lybra queue claim",
      "stage_contract": {
        "two_stage": true,
        "dry_run_emits_token": true,
        "self_confirm_allowed": ["executor_with_owner_confirmed_literal"],
        "self_confirm_mechanism": "AIPOS-328: executor passes owner_confirmation_token='OWNER_CONFIRMED' literal (not a secret, not owner scope)",
        "owner_confirmation_required_in_response": false,
        "client_hint_template": "AIPOS-328: executor自行confirm。使用 lybra_queue_claim_confirm 带上 dry_run_token 与 owner_confirmation_token='OWNER_CONFIRMED'(字面常量,非秘密)。Owner不需参与此步骤。"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task to claim (selector: task_id XOR task_path)" },
          "task_path": { "type": "string", "description": "Task path (selector: task_id XOR task_path)" },
          "actor": { "type": "string", "description": "Agent claiming the task" },
          "agent_instance": { "type": "string", "description": "Specific agent instance" },
          "autonomy_mode": { "type": "string", "$enum": "autonomy_mode", "description": "Supervised | PreAuthorized" },
          "owner_policy_ref": { "type": "string", "description": "Owner policy reference" },
          "runtime_profile": { "type": "string", "description": "Runtime profile (e.g. cc)" },
          "active_session_id": { "type": "string", "description": "Active session identifier" },
          "context_bundle_ack": { "type": "string", "description": "Context bundle acknowledgement" },
          "with_records": { "type": "boolean", "description": "Include records in response" },
          "claim_reason": { "type": "string", "description": "Reason for claiming" },
          "actual_model": { "type": "string", "description": "Self-reported model identifier" },
          "reported_tokens": { "type": "integer", "description": "Self-reported token usage" }
        },
        "required": ["actor", "agent_instance", "autonomy_mode", "owner_policy_ref"],
        "additionalProperties": false
      }
    },
    "lybra_queue_claim_confirm": {
      "description": "Confirm a claim dry-run (AIPOS-328: self-confirm via owner_confirmation_token literal).",
      "phase": "confirm",
      "base_verb": "lybra_queue_claim",
      "dry_run_verb": "lybra_queue_claim_dry_run",
      "confirm_via": "dry_run_token",
      "surface": ["mcp"],
      "stage_contract": {
