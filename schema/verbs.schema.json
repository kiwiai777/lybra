{
  "schema_version": "2.0.0",
  "description": "Lybra verb contracts — single source of truth for gate tool names, parameter shapes, and two-phase (dry_run → confirm) semantics. Keyed by ACTUAL gate tool name (verb full name includes the phase suffix). Connectors derive verb name + parameter shape from this file at load time; a missing verb or a wrong required-param name fails at startup, not at runtime.",
  "last_updated": "2026-08-16",
  "source_of_truth": "This file mirrors the live gate registry (tools/list). It is the ONLY place a connector may learn a verb name or a parameter shape. No handwritten per-verb wrappers in connectors.",
  "two_phase_protocol": {
    "description": "Mutation verbs follow dry_run → confirm two-phase pattern. dry_run previews without side effects and (for claim/return) returns a dry_run_token; confirm executes.",
    "phases": {
      "dry_run": {
        "purpose": "Preview operation without side effects",
        "returns": "Operation plan, validation results, and (for claim/return) dry_run_token for confirmation"
      },
      "confirm": {
        "purpose": "Execute the operation",
        "requires": "claim/return: valid dry_run_token from the dry_run phase. close: replays task_id + actor + closure_evidence (no dry_run_token)."
      }
    }
  },
  "warn_behavior": {
    "description": "WARN behavior contract - consistent across all verbs",
    "rules": [
      "WARN is non-blocking - operation proceeds with warnings",
      "WARN never consumes tokens - dry_run_token remains valid",
      "WARN never blocks subsequent operations",
      "WARN messages are recorded but do not prevent confirmation",
      "Executor can proceed through WARN to completion"
    ]
  },
  "verbs": {
    "lybra_queue_list": {
      "description": "Read the task queue (executor's only read surface).",
      "phase": "single",
      "required_scope": null,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "lybra_task_preview": {
      "description": "Read-only task session preview by task_id or path. include_body=true returns the card body markdown (requires queue_claim scope).",
      "phase": "single",
      "required_scope": null,
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task identifier" },
          "path": { "type": "string", "description": "Task card path" },
          "actor": { "type": "string", "description": "Requesting actor" },
          "include_body": { "type": "boolean", "description": "Include card body markdown (requires queue_claim scope)" }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "lybra_return_content": {
      "description": "Read-only: return RETURN.md body for a returned task (auditor cross-machine evidence). Requires queue_claim scope.",
      "phase": "single",
      "required_scope": null,
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task whose RETURN.md to read" }
        },
        "required": ["task_id"],
        "additionalProperties": false
      }
    },
    "lybra_queue_claim_dry_run": {
      "description": "Claim a pending task (preview; PreAuthorized may release in one phase).",
      "phase": "dry_run",
      "base_verb": "lybra_queue_claim",
      "confirm_verb": "lybra_queue_claim_confirm",
      "confirm_via": "dry_run_token",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task to claim (selector: task_id XOR task_path)" },
          "task_path": { "type": "string", "description": "Task path (selector: task_id XOR task_path)" },
          "actor": { "type": "string", "description": "Agent claiming the task" },
          "agent_instance": { "type": "string", "description": "Specific agent instance" },
          "autonomy_mode": { "type": "string", "$enum": "autonomy_mode", "description": "Supervised | PreAuthorized" },
          "owner_policy_ref": { "type": "string", "description": "Owner policy reference" },
          "runtime_profile": { "type": "string", "description": "Runtime profile (e.g. cc)" },
          "active_session_id": { "type": "string", "description": "Active session identifier" },
          "context_bundle_ack": { "type": "string", "description": "Context bundle acknowledgement" },
          "with_records": { "type": "boolean", "description": "Include records in response" },
          "claim_reason": { "type": "string", "description": "Reason for claiming" },
          "actual_model": { "type": "string", "description": "Self-reported model identifier" },
          "reported_tokens": { "type": "integer", "description": "Self-reported token usage" }
        },
        "required": ["actor", "agent_instance", "autonomy_mode", "owner_policy_ref"],
        "additionalProperties": false
      }
    },
    "lybra_queue_claim_confirm": {
      "description": "Confirm a claim dry-run (Owner-gated: requires owner_confirmation_token).",
      "phase": "confirm",
      "base_verb": "lybra_queue_claim",
      "dry_run_verb": "lybra_queue_claim_dry_run",
      "confirm_via": "dry_run_token",
      "parameters": {
        "type": "object",
        "properties": {
          "dry_run_token": { "type": "string", "description": "Token from dry_run phase" },
          "actor": { "type": "string" },
          "agent_instance": { "type": "string" },
          "owner_policy_ref": { "type": "string" },
          "owner_confirmation_token": { "type": "string", "description": "Owner confirmation literal" }
        },
        "required": ["dry_run_token", "actor", "agent_instance", "owner_policy_ref", "owner_confirmation_token"],
        "additionalProperties": false
      }
    },
    "lybra_queue_return_dry_run": {
      "description": "Return completed work (preview).",
      "phase": "dry_run",
      "base_verb": "lybra_queue_return",
      "confirm_verb": "lybra_queue_return_confirm",
      "confirm_via": "dry_run_token",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "task_path": { "type": "string" },
          "actor": { "type": "string" },
          "agent_instance": { "type": "string" },
          "autonomy_mode": { "type": "string", "$enum": "autonomy_mode", "description": "Supervised for executor return" },
          "owner_policy_ref": { "type": "string" },
          "claim_id": { "type": "string" },
          "active_session_id": { "type": "string" },
          "result_summary": { "type": "string" },
          "artifact_refs": { "type": "array", "items": { "type": "string" } },
          "scratch_dir": { "type": "string" },
          "scratch_artifact_refs": { "type": "array", "items": { "type": "string" } },
          "completion_report_ref": { "type": "string" },
          "executor_status": { "type": "string", "description": "completed (single allowed value)" },
          "audit_readiness": { "type": "string", "description": "ready (single allowed value)" },
          "return_reason": { "type": "string" },
          "return_body": { "type": "string", "description": "RETURN.md body text (gate writes task_cards/<ID>/RETURN.md on confirm)" },
          "actual_model": { "type": "string" },
          "reported_tokens": { "type": "integer" },
          "agent_runtime": {
            "type": "object",
            "description": "Agent-reported runtime bundle (never verified)",
            "properties": {
              "harness": { "type": "string" },
              "model_self_reported": { "type": "string" },
              "tokens_in": { "type": "integer" },
              "tokens_out": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "required": ["actor", "agent_instance", "autonomy_mode", "owner_policy_ref"],
        "additionalProperties": false
      }
    },
    "lybra_queue_return_confirm": {
      "description": "Confirm a return dry-run (AIPOS-328: executor self-confirm via owner_confirmation_token).",
      "phase": "confirm",
      "base_verb": "lybra_queue_return",
      "dry_run_verb": "lybra_queue_return_dry_run",
      "confirm_via": "dry_run_token",
      "parameters": {
        "type": "object",
        "properties": {
          "dry_run_token": { "type": "string" },
          "actor": { "type": "string" },
          "agent_instance": { "type": "string" },
          "owner_policy_ref": { "type": "string" },
          "owner_confirmation_token": { "type": "string" }
        },
        "required": ["dry_run_token", "actor", "agent_instance", "owner_policy_ref", "owner_confirmation_token"],
        "additionalProperties": false
      }
    },
    "lybra_queue_close_dry_run": {
      "description": "Close a task (preview). closure_evidence is an OBJECT, not a flat string.",
      "phase": "dry_run",
      "base_verb": "lybra_queue_close",
      "confirm_verb": "lybra_queue_close_confirm",
      "confirm_via": "replay_args",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "actor": { "type": "string" },
          "closure_evidence": {
            "type": "object",
            "description": "At least one of: finalize_commit_hash, finalize_return_ref, owner_verification_ref.",
            "properties": {
              "finalize_commit_hash": { "type": "string" },
              "finalize_return_ref": { "type": "string" },
              "owner_verification_ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "required": ["task_id", "actor", "closure_evidence"],
        "additionalProperties": false
      }
    },
    "lybra_queue_close_confirm": {
      "description": "Confirm close. Replays task_id + actor + closure_evidence (NO dry_run_token — close confirm takes the full args again).",
      "phase": "confirm",
      "base_verb": "lybra_queue_close",
      "dry_run_verb": "lybra_queue_close_dry_run",
      "confirm_via": "replay_args",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "actor": { "type": "string" },
          "closure_evidence": {
            "type": "object",
            "description": "At least one of: finalize_commit_hash, finalize_return_ref, owner_verification_ref.",
            "properties": {
              "finalize_commit_hash": { "type": "string" },
              "finalize_return_ref": { "type": "string" },
              "owner_verification_ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "required": ["task_id", "actor", "closure_evidence"],
        "additionalProperties": false
      }
    },
    "lybra_task_progress": {
      "description": "Report task progress (single-phase). NOTE: field is event_type, NOT status.",
      "phase": "single",
      "required_scope": "task_progress",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Task being reported on" },
          "event_type": { "type": "string", "$enum": "progress_status", "description": "started | progress | completed | blocked" },
          "actor": { "type": "string", "description": "Agent instance reporting" },
          "summary": { "type": "string" },
          "model_self_reported": { "type": "string" },
          "stage": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["task_id", "event_type", "actor"],
        "additionalProperties": false
      }
    },
    "lybra_bench_audit_submit_dry_run": {
      "description": "Submit a bench-audit evidence bundle (dry_run).",
      "phase": "dry_run",
      "base_verb": "lybra_bench_audit_submit",
      "confirm_via": "dry_run_token",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "actor": { "type": "string" },
          "evidence_type": { "type": "string", "description": "deploy | config | content | research" },
          "task_mode": { "type": "string", "description": "deploy | config | content | research" },
          "conclusion": { "type": "string", "description": "pass | pass_with_notes | fail | needs_human" },
          "evidence_refs": { "type": "array", "items": { "type": "object" }, "description": "[{check_id, ref, note?}]" },
          "notes": { "type": "string" }
        },
        "required": ["task_id", "actor", "conclusion"],
        "additionalProperties": false
      }
    }
  }
}
