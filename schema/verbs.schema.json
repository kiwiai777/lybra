    "lybra_queue_close_dry_run": {
      "description": "Close a task (preview). closure_evidence is an OBJECT, not a flat string.",
      "phase": "dry_run",
      "base_verb": "lybra_queue_close",
      "confirm_verb": "lybra_queue_close_confirm",
      "confirm_via": "replay_args",
      "surface": ["cli", "mcp"],
      "cli_command": "lybra queue close",
      "stage_contract": {
        "two_stage": true,
        "dry_run_emits_token": false,
        "confirm_mechanism": "replay_args: confirm replays task_id + actor + closure_evidence (no dry_run_token)",
        "self_confirm_allowed": ["executor_with_queue_close_scope"],
        "self_confirm_mechanism": "Executor with queue_close scope can close directly; no owner_confirmation_token needed",
        "owner_confirmation_required_in_response": false,
        "client_hint_template": "Executor可直接close(queue_close scope)。使用 lybra queue close --task-id <ID> --actor <ACTOR> --closure-evidence '<JSON>'。无需owner确认。"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "actor": { "type": "string" },
          "closure_evidence": {
            "type": "object",
            "description": "At least one of: finalize_commit_hash, finalize_return_ref, owner_verification_ref.",
            "properties": {
              "finalize_commit_hash": { "type": "string" },
              "finalize_return_ref": { "type": "string" },
              "owner_verification_ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "required": ["task_id", "actor", "closure_evidence"],
        "additionalProperties": false
      }
    },
