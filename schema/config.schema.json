{
  "schema_version": "1.0.0",
  "description": "Lybra configuration schema - structure and sources for all configuration, NO hardcoded values in code",
  "last_updated": "2026-08-11",
  "configuration_sources": {
    "connection": {
      "description": "Gate connection configuration",
      "source_file": ".lybra/connection.json",
      "schema": {
        "gate_url": {
          "type": "string",
          "required": true,
          "description": "Gate server URL",
          "example": "http://127.0.0.1:7118"
        },
        "project": {
          "type": "string",
          "required": true,
          "description": "Project identifier"
        },
        "workspace_root": {
          "type": "string",
          "required": false,
          "description": "Workspace root path (can be inferred)"
        }
      }
    },
    "role": {
      "description": "Agent role configuration",
      "source_file": ".lybra/role.json",
      "schema": {
        "role": {
          "type": "string",
          "required": true,
          "description": "Agent role category",
          "$enum": "role_category"
        },
        "agent_instance": {
          "type": "string",
          "required": true,
          "description": "Agent instance identifier"
        },
        "credential_token": {
          "type": "string",
          "required": true,
          "description": "Role credential token (enrolled by gate)"
        }
      }
    },
    "policy": {
      "description": "Autonomy policy configuration",
      "source_file": ".lybra/policy.json",
      "schema": {
        "policy_id": {
          "type": "string",
          "required": true,
          "description": "Policy identifier"
        },
        "autonomy_mode": {
          "type": "string",
          "$enum": "autonomy_mode",
          "required": true,
          "description": "Default autonomy mode"
        },
        "claim_limits": {
          "type": "object",
          "description": "Claim limits for this policy"
        }
      }
    },
    "workspace_config": {
      "description": "Workspace-level configuration",
      "source_file": ".lybra/config.json",
      "schema": {
        "workspace_root": {
          "type": "string",
          "required": true,
          "description": "Workspace root directory"
        },
        "project": {
          "type": "string",
          "required": true,
          "description": "Project identifier"
        },
        "governance_root": {
          "type": "string",
          "required": true,
          "description": "Governance repository root path"
        },
        "code_repo": {
          "type": "string",
          "required": false,
          "description": "Code repository path (for code tasks)"
        },
        "worktree_root": {
          "type": "string",
          "required": false,
          "description": "Root directory for task-specific worktrees (AIPOS-R5A)",
          "default": "{code_repo}/.worktrees"
        }
      }
    }
  },
  "ports": {
    "description": "Service port configuration — single source for all port defaults. AIPOS-R4B-1: code reads these via schema_loader.get_config_port(); the 35 hardcoded 7117/7118 references in tools/ (non-test) route through here. board_default added (was missing: board port 7117 had no single source).",
    "board_default": 7117,
    "gate_default": 7118,
    "gate_range": "7100-7199",
    "mcp_server_default": 7118,
    "auditor_loop_default": 7119,
    "tunnel_default": 7120
  },
  "timeouts": {
    "description": "Timeout configuration — single source for all timeout defaults. 坑② 修复(R5B前置): timeoutMs 从配置读取,不写死。顾问实测证明网络路径等速(127.0.0.1 vs tailscale 均 2.2s/461卡),真凶在连接器内部预算累加(initialize+queueTasks+claimDryRun+taskPreview 串行)。",
    "gate_mcp_request_ms": 30000,
    "gate_mcp_request_description": "Gate MCP 单次请求超时(ms)。默认 30s 对齐 LOOP-REDESIGN 护栏常量审查;实测本机单次操作 <3s,30s 为多次串行累加留足容错预算。计时日志(fetch-timing/dryrun-timing/preview-timing/tick-total-timing)用于排查慢点。"
  },
  "urls": {
    "description": "URL patterns and defaults",
    "gate_local": "http://127.0.0.1:7118",
    "gate_tailscale_pattern": "http://{hostname}.{tailnet}:7118"
  },
  "governance_structure": {
    "description": "Governance repository fixed directory structure - read from workspace config, NOT hardcoded",
    "paths": {
      "governance_root": {
        "source": "workspace_config.governance_root",
        "description": "Root of governance repository"
      },
      "governance_docs": {
        "relative_to": "governance_root",
        "path": "governance/",
        "description": "Governance documents directory",
        "files": {
          "decision_log": "decision_log.md",
          "project_status": "project_status.md",
          "roadmap": "roadmap.md",
          "loop_design": "LOOP-REDESIGN.md"
        }
      },
      "tasks_root": {
        "relative_to": "governance_root",
        "path": "5_tasks/",
        "description": "Tasks root directory"
      },
      "queue": {
        "relative_to": "tasks_root",
        "path": "queue/",
        "description": "Task queue directory",
        "subdirs": [
          "pending/",
          "claimed/",
          "returned/",
          "completed/",
          "blocked/",
          "withdrawn/"
        ]
      },
      "drafts": {
        "relative_to": "tasks_root",
        "path": "drafts/",
        "description": "Draft tasks directory"
      },
      "records": {
        "relative_to": "tasks_root",
        "path": "records/",
        "description": "Task records root",
        "subdirs": [
          "claims/",
          "returns/",
          "closures/",
          "audit_dispatches/",
          "audit_verdicts/",
          "owner_decisions/",
          "owner_verifications/",
          "publishes/",
          "events/",
          "sessions/"
        ]
      },
      "stage_archive": {
        "relative_to": "governance_root",
        "path": "stage_archive/",
        "description": "Stage completion archive directory"
      }
    }
  },
  "n6_closure_checklist": {
    "description": "N6 closure node governance updates checklist - what files to update on task completion",
    "updates": [
      {
        "file": "governance/decision_log.md",
        "action": "append",
        "description": "Append task completion decision to decision log"
      },
      {
        "file": "governance/project_status.md",
        "action": "update_section",
        "description": "Update relevant sections in project status"
      },
      {
        "file": "governance/roadmap.md",
        "action": "update_section",
        "description": "Update roadmap if task affects milestones"
      },
      {
        "file": "5_tasks/queue/completed/{task_id}.md",
        "action": "move",
        "description": "Move task card to completed queue"
      },
      {
        "file": "stage_archive/{stage_id}/",
        "action": "create_or_append",
        "description": "Archive stage completion documentation (on stage boundary)",
        "condition": "stage_completion"
      }
    ],
    "final_action": {
      "operation": "git_push",
      "repository": "governance_repo",
      "description": "Push all governance updates to remote (push is part of N6 node)"
    }
  },
  "path_conventions": {
    "description": "Path conventions used throughout the system",
    "task_card_filename": "{task_id_slug}.md",
    "claim_record": "5_tasks/records/claims/{task_id}/claim_{task_id}_{timestamp}_{agent}.md",
    "return_record": "5_tasks/records/returns/{task_id}/return_{task_id}_{timestamp}_{agent}.md",
    "closure_record": "5_tasks/records/closures/{task_id}/closure_{task_id}_{timestamp}.md",
    "audit_dispatch_record": "5_tasks/records/audit_dispatches/{task_id}/dispatch_{task_id}_{timestamp}.md",
    "audit_verdict_record": "5_tasks/records/audit_verdicts/{task_id}/verdict_{task_id}_{timestamp}_{auditor}.md",
    "session_record": "5_tasks/records/sessions/{task_id}/session_{session_id}.md",
    "event_record": "5_tasks/records/events/{task_id}/{event_type}_{task_id}_{timestamp}.md"
  },
  "environment_variables": {
    "description": "Environment variables that can override config file values",
    "variables": {
      "AIPOS_WORKSPACE_ROOT": {
        "type": "string",
        "description": "Override workspace root path"
      },
      "LYBRA_GATE_URL": {
        "type": "string",
        "description": "Override gate server URL"
      },
      "LYBRA_HOME_ROOT": {
        "type": "string",
        "description": "Home root for multi-workspace resolution"
      },
      "LYBRA_CAPABILITY_TOKEN": {
        "type": "string",
        "description": "Capability token for scoped operations"
      }
    },
    "precedence": "Environment variables override config files"
  },
  "multi_project_support": {
    "description": "Multi-project configuration - gate serves multiple projects",
    "project_registry": {
      "source": "gate configuration",
      "description": "Gate maintains registry of all projects",
      "structure": {
        "project_id": "string",
        "governance_root": "path",
        "code_repo": "path (optional)",
        "workspace_root": "path"
      }
    },
    "scope_isolation": {
      "description": "All operations scoped by (project, instance) tuple",
      "rules": [
        "queue_list filtered by project",
        "held checks per (project, instance)",
        "claim eligibility per project",
        "session binding per project"
      ]
    }
  },
  "governance_worktree": {
    "description": "AIPOS-R5B: Per-project governance worktree configuration — 解决 FND-24 多项目共用一工作树推送相撞。复用 R5A worktree_manager.py 一机制一实现。",
    "branch_semantics": {
      "gov_prefix": {
        "pattern": "gov/<project>",
        "semantic": "collection_lane",
        "description": "收集车道(collection lane)非特性分叉 — 每次收账即 merge 回 main, 差距不过夜。与 LOOP-REDESIGN §6 '分叉活不过一张卡' 红线不冲突(语义声明在此, 非硬编码特判)。",
        "lifecycle": "persistent per-project branch + dedicated worktree",
        "merge_policy": "frequent convergence to main (不过夜)"
      },
      "card_prefix": {
        "pattern": "card/<task_id>",
        "semantic": "ephemeral_task_branch",
        "description": "临时任务分支 — 分叉活不过一张卡, finalize 时 merge + 删分支 + 删 worktree",
        "lifecycle": "created on claim, deleted on finalize"
      }
    },
    "path_constraints": {
      "description": "AIPOS-R6A 靶子⑨: 治理仓路径白名单 — 明确哪些路径可写。代码文件(.py/.js/.ts等)一律禁止，只允许文档、记录、配置。",
      "per_project_allowed_pattern": "2_projects/<project>/**",
      "common_paths_whitelist": [
        "governance/**/*.md",
        "0_control_plane/**",
        "2_projects/**",
        "5_tasks/records/**",
        "5_tasks/policies/**",
        "5_tasks/queue/**/*.md",
        "stage_archive/**",
        "README.md",
        "*.md"
      ],
      "violation_policy": "BLOCK with explicit file list. Code files in governance repo = protocol violation (治理仓从此无代码可改).",
      "code_files_blacklist": [
        "**/*.py",
        "**/*.js",
        "**/*.ts",
        "**/*.tsx",
        "**/*.jsx",
        "**/*.java",
        "**/*.go",
        "**/*.rs",
        "**/*.c",
        "**/*.cpp",
        "**/*.sh",
        "**/*.bash"
      ]
    },
    "merge_convergence": {
      "description": "merge 收敛动词 — 一条命令合所有 gov/<project> 回 main 并 push",
      "operation": "merge_all_gov_branches",
      "strategy": "no-ff merge (保留历史)",
      "conflict_resolution": "目录隔离 → 零冲突预期; 真冲突 → 越界改他人目录 → BLOCK 列文件",
      "single_truth": "origin main = 唯一真相, 禁第二 origin/镜像"
    },
    "coexistence": {
      "description": "共存期策略 — 现有直推 main 流程照常",
      "current_workflows_unchanged": true,
      "agency_chris_kaia_untouched": "本卡零接触 agency/chris 工作流, kaia-kb 只读",
      "migration_deferred": "切换另行安排, 非本卡范围"
    }
  }
}