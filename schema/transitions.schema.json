{
  "schema_version": "1.0.0",
  "description": "Lybra state machine transition table - declarative workflow for N0→N6 main flow + G1-G3 cross-cutting",
  "last_updated": "2026-08-11",
  "main_flow": {
    "description": "Main task lifecycle nodes N0→N6 - unidirectional progression",
    "nodes": [
      {
        "node_id": "N0",
        "name": "publish",
        "description": "Task creation and publication to pending queue",
        "trigger": "planner or advisor",
        "from_state": "draft",
        "to_state": "pending",
        "verb": "lybra_draft_publish",
        "validation": [
          "Schema validation against card.schema.json",
          "Required fields check",
          "Undefined/misspelled field detection",
          "Enum value validation",
          "Runtime fields forbidden in draft",
          "Task ID uniqueness check"
        ],
        "outputs": [
          "Task card moved to 5_tasks/queue/pending/",
          "Publish record created"
        ],
        "records": {
          "record_type": "publish",
          "location": "5_tasks/records/publishes/<task_id>/publish_*.md",
          "fields": ["record_type", "task_id", "actor", "timestamp", "draft_path", "published_path"]
        },
        "next_trigger": "executor claims task (N1)",
        "idempotent": false,
        "notes": "Draft template generated from card.schema required fields"
      },
      {
        "node_id": "N1",
        "name": "claim",
        "description": "Task claim by executor",
        "trigger": "executor agent",
        "from_state": "pending",
        "to_state": "claimed",
        "verb": "lybra_queue_claim",
        "context_return": {
          "description": "Gate returns LoopContext fields on claim",
          "fields": [
            "project",
            "workspace_root",
            "code_repo",
            "task_state",
            "worktree"
          ]
        },
        "checks": [
          "Task is claimable (pending state)",
          "Agent matches assigned_to (or claim_policy allows)",
          "Held check by (project, instance) - no conflicting active claims",
          "Policy allows claim (autonomy_mode, claim limits)"
        ],
        "outputs": [
          "Task card moved to 5_tasks/queue/claimed/",
          "Claim record created",
          "Session record created",
          "Task bound to session and worktree"
        ],
        "records": {
          "record_type": "claim",
          "location": "5_tasks/records/claims/<task_id>/claim_*.md",
          "fields": ["record_type", "task_id", "claim_id", "actor", "agent_instance", "claimed_at", "autonomy_mode", "owner_policy_ref"]
        },
        "next_trigger": "executor completes work (N2→N3)",
        "idempotent": true,
        "notes": "Claim binds task to specific session and worktree"
      },
      {
        "node_id": "N2",
        "name": "execute",
        "description": "Task execution phase - executor performs work",
        "trigger": "executor agent (in claimed session)",
        "state": "claimed (no state change, work in progress)",
        "progress_verb": "lybra_task_progress",
        "materialization": {
          "description": "Gate materializes context for executor",
          "363F1": "Task card body and frontmatter",
          "363F2": "Referenced files declared in card"
        },
        "controlled_write": {
          "description": "Executor writes within declared scope",
          "artifact_policy": "Determines write permissions",
          "output_target": "Declares write scope"
        },
        "progress_reporting": [
          "started - work begins",
          "progress - intermediate updates",
          "completed - work done",
          "blocked - cannot proceed"
        ],
        "records": {
          "record_type": "task_progress_event",
          "location": "5_tasks/records/events/<task_id>/{started|progress|completed|blocked}_*.md",
          "fields": ["record_type", "task_id", "event_type", "actor", "timestamp", "summary", "model_self_reported"]
        },
        "commit_requirement": "Executor must commit changes before return (commit-before-return)",
        "next_trigger": "executor returns work (N3)",
        "idempotent": "N/A (ongoing work phase)",
        "notes": "This is the actual work phase, not a state transition node"
      },
      {
        "node_id": "N3",
        "name": "return",
        "description": "Executor returns completed work",
        "trigger": "executor agent",
        "from_state": "claimed",
        "to_state": "returned",
        "verb": "lybra_queue_return",
        "checks": [
          "Task is claimed by returning agent",
          "Commit check - changes are committed",
          "Session is active"
        ],
        "outputs": [
          "Task card moved to 5_tasks/queue/returned/",
          "Return record created with completion notes and artifact refs",
          "Session updated"
        ],
        "records": {
          "record_type": "return",
          "location": "5_tasks/records/returns/<task_id>/return_*.md",
          "fields": ["record_type", "task_id", "return_id", "actor", "returned_at", "artifact_refs", "completion_summary", "performed_writes"]
        },
        "next_trigger": "audit dispatch (N4) or advisor review (non-code) or direct close (N6)",
        "idempotent": true,
        "recoverable": true,
        "notes": "Return is idempotent - retry after failure produces clean re-recording"
      },
      {
        "node_id": "N4",
        "name": "audit",
        "description": "Independent audit of completed work",
        "trigger": "auditor agent (after audit_dispatch)",
        "state": "returned (no state change during audit)",
        "applies_to": "task_mode=code tasks only",
        "skip_for": ["docs", "governance", "config"],
        "audit_dispatch_verb": "lybra_audit_dispatch",
        "audit_verdict_verb": "lybra_audit_verdict",
        "flow": [
          "Gate auto-generates audit task (R card)",
          "Owner or owner-dispatch assigns auditor",
          "Auditor claims R card",
          "Auditor reviews work and submits verdict"
        ],
        "verdicts": [
          {
            "verdict": "PASS",
            "description": "Work approved, proceed to finalize",
            "next": "N5 finalize"
          },
          {
            "verdict": "PASS_WITH_NOTES",
            "description": "Work approved with advisory notes",
            "next": "N5 finalize"
          },
          {
            "verdict": "FAIL",
            "description": "Work requires fixes",
            "next": "Fix loop (max 2 iterations, then escalate to advisor)"
          },
          {
            "verdict": "BLOCK",
            "description": "Blocking issue, cannot proceed",
            "next": "Escalate to owner/advisor"
          },
          {
            "verdict": "WARN",
            "description": "Warning issued, non-blocking",
            "next": "Record warning, continue flow"
          }
        ],
        "outputs": [
          "Audit verdict record created"
        ],
        "records": {
          "audit_dispatch": {
            "record_type": "audit_dispatch",
            "location": "5_tasks/records/audit_dispatches/<task_id>/dispatch_*.md",
            "fields": ["record_type", "task_id", "audit_task_id", "dispatched_by", "dispatched_at", "auditor_assigned", "return_record_ref"]
          },
          "audit_verdict": {
            "record_type": "audit_verdict",
            "location": "5_tasks/records/audit_verdicts/<task_id>/verdict_*.md",
            "fields": ["record_type", "task_id", "audit_task_id", "verdict", "verdict_id", "auditor", "verdict_at", "findings", "reviewed_executor_instance"]
          }
        },
        "next_trigger": "PASS/PASS_WITH_NOTES → executor finalizes (N5); FAIL → fix loop; BLOCK → escalation",
        "notes": "Non-code tasks skip N4, use advisor review instead (gate still records verdict)"
      },
      {
        "node_id": "N5",
        "name": "finalize",
        "description": "Commit to product repo, push, and deploy",
        "trigger": "executor agent (after PASS verdict)",
        "prerequisite": "Audit verdict = PASS or PASS_WITH_NOTES (gate enforces via FND-14)",
        "applies_to": "task_mode=code tasks only",
        "skip_for": ["docs", "governance", "config"],
        "verb": "lybra_finalize",
        "actions": [
          "Commit changes to product repo with precise pathspec (no add -A)",
          "Push to remote repository",
          "Deploy if deployment is specified",
          "Update finalize status in task card"
        ],
        "safety_checks": [
          "No cwd fallback (explicit paths only)",
          "No add -A (precise pathspec from task)",
          "Verify remote tracking branch",
          "Deployment sanity checks"
        ],
        "outputs": [
          "Product repo commit and push",
          "Finalize record created",
          "Deployment completed (if applicable)"
        ],
        "records": {
          "record_type": "deployment_record",
          "location": "5_tasks/records/deployments/<task_id>/deployment_*.md",
          "fields": ["record_type", "task_id", "commit", "actor", "timestamp", "authorization", "verdict_ref", "deployed", "deployment_provenance"]
        },
        "next_trigger": "executor closes task (N6)",
        "notes": "Non-code tasks skip N5, advisor review handles governance updates directly"
      },
      {
        "node_id": "N6",
        "name": "close",
        "description": "Task closure and governance updates",
        "trigger": "executor (automatic when closure evidence complete) or advisor",
        "from_state": "returned or completed",
        "to_state": "completed",
        "verb": "lybra_queue_close",
        "phases": [
          {
            "phase": "closure_record",
            "description": "Create closure record with evidence",
            "evidence_required": true
          },
          {
            "phase": "governance_updates",
            "description": "Update governance documents",
            "updates": [
              {
                "file": "governance/decision_log.md",
                "action": "append",
                "description": "Append task completion to decision log"
              },
              {
                "file": "governance/project_status.md",
                "action": "update",
                "description": "Update project status (if relevant sections exist)"
              },
              {
                "file": "governance/roadmap.md",
                "action": "update",
                "description": "Update roadmap (if milestones affected)"
              },
              {
                "file": "stage_archive/{stage}/",
                "action": "archive",
                "description": "Stage archive (on stage completion boundary)",
                "condition": "stage_completion"
              }
            ]
          },
          {
            "phase": "task_archive",
            "description": "Archive task card",
            "action": "Move task card to 5_tasks/queue/completed/{task_id}.md"
          },
          {
            "phase": "governance_push",
            "description": "Push governance repo changes",
            "action": "git push governance repo",
            "critical": true,
            "notes": "Push is part of N6 node (lesson from 2026-08-11: commit without push = incomplete closure)"
          }
        ],
        "automation": "Auto-advances when closure evidence is complete (證據齊→自動推進)",
        "outputs": [
          "Task card in 5_tasks/queue/completed/",
          "Closure record created",
          "Governance documents updated",
          "Governance repo pushed to remote"
        ],
        "records": {
          "record_type": "closure",
          "location": "5_tasks/records/closures/<task_id>/closure_*.md",
          "fields": ["record_type", "task_id", "closed_by", "closed_at", "closure_evidence_ref", "governance_commit_hash"]
        },
        "idempotent": true,
        "notes": "N6 includes full governance reconciliation - fixed update list in config.schema"
      }
    ]
  },
  "task_mode_routing": {
    "description": "Task workflow routing based on task_mode field",
    "routes": {
      "code": {
        "description": "Code implementation tasks",
        "flow": "N0 → N1 → N2 → N3 → N4 (independent audit) → N5 (finalize) → N6 (close)",
        "audit": "Independent audit required (N4)",
        "finalize": "Commit/push to product repo (N5)"
      },
      "docs": {
        "description": "Documentation tasks",
        "flow": "N0 → N1 → N2 → N3 → advisor_review → N6 (close)",
        "audit": "Advisor review replaces N4",
        "skip_nodes": ["N4", "N5"],
        "notes": "Advisor review verdict recorded via gate (gate落record), preserves audit trail"
      },
      "governance": {
        "description": "Governance document tasks",
        "flow": "N0 → N1 → N2 → N3 → advisor_review → N6 (close)",
        "audit": "Advisor review replaces N4",
        "skip_nodes": ["N4", "N5"],
        "notes": "Direct governance updates, advisor must not audit own work"
      },
      "config": {
        "description": "Configuration tasks",
        "flow": "N0 → N1 → N2 → N3 → advisor_review → N6 (close)",
        "audit": "Advisor review replaces N4",
        "skip_nodes": ["N4", "N5"],
        "notes": "Config changes reviewed by advisor, skip independent audit"
      }
    },
    "advisor_review_rules": [
      "Advisor review for docs/governance/config is equivalent to independent audit for accountability",
      "Advisor verdict still recorded via gate (not verbal, not manual notes)",
      "Card header audit: required can force independent audit even for non-code",
      "Advisor cannot audit own executed work (that escalates to Owner or independent auditor)",
      "Advisor review maintains second-pair-of-eyes principle"
    ]
  },
  "cross_cutting": {
    "description": "Cross-cutting concerns G1-G3 - not tied to specific nodes, span entire lifecycle",
    "g1_owner_gate": {
      "name": "Owner Gate",
      "description": "Owner confirmation and verification gates",
      "applies_to": "All operations requiring owner approval",
      "triggers": [
        "Supervised autonomy_mode claim/return confirm",
        "owner_verify=true tasks (after PASS, before finalize)",
        "Owner veto (any time)"
      ],
      "verbs": [
        "lybra_owner_decision",
        "owner confirmation on claim_confirm/return_confirm"
      ],
      "rules": [
        "Owner confirm scope separate from operation scope",
        "Executor cannot self-confirm (even with OWNER_CONFIRMED literal)",
        "Owner veto available at any point in lifecycle",
        "Owner decisions recorded via gate"
      ]
    },
    "g2_maintenance": {
      "name": "Maintenance Verbs",
      "description": "Queue maintenance operations",
      "verbs": [
        {
          "verb": "lybra_queue_withdraw",
          "description": "Withdraw task from queue (any state)",
          "non_blocking_warn": true,
          "preserves_records": true,
          "notes": "Malformed/legacy tasks can always be withdrawn"
        },
        {
          "verb": "lybra_queue_amend",
          "description": "Amend pending task metadata/body",
          "constraint": "Only pending tasks",
          "preserves_history": true
        },
        {
          "verb": "lybra_task_reopen",
          "description": "Reopen completed/blocked task",
          "constraint": "Requires reason and owner approval"
        }
      ],
      "warn_behavior": "Non-blocking WARN never consumes tokens, never blocks operations"
    },
    "g3_derivation_dispatch": {
      "name": "Derivation and Dispatch",
      "description": "Task derivation and audit dispatch",
      "operations": [
        {
          "operation": "audit_derivation",
          "description": "Gate mechanically derives R card from parent task",
          "trigger": "Task return (N3)",
          "applies_to": "task_mode=code only",
          "notes": "Auto-generated audit tasks never enter queue (direct assignment)"
        },
        {
          "operation": "audit_dispatch",
          "description": "Owner-dispatch assigns auditor to R card",
          "trigger": "Manual dispatch by owner or owner-dispatch role",
          "verb": "lybra_audit_dispatch"
        }
      ]
    }
  },
  "idempotency_guarantees": {
    "description": "Idempotency and retry behavior for all nodes",
    "rules": {
      "N0_publish": "Not idempotent - duplicate task_id blocked at validation",
      "N1_claim": "Idempotent - re-claim same task by same agent safe",
      "N2_execute": "N/A (ongoing work, not a transaction)",
      "N3_return": "Idempotent - retry produces clean re-recording",
      "N4_audit": "Idempotent - re-submit verdict safe",
      "N5_finalize": "Idempotent - re-finalize checks existing commit/push",
      "N6_close": "Idempotent - re-close safe, governance updates merge"
    },
    "general_principle": "All state transitions are idempotent and recoverable - retry after failure is safe"
  },
  "state_gaps": {
    "description": "Completeness check - no unreachable states",
    "coverage": "All queue states reachable via declared transitions",
    "unreachable_states": [],
    "notes": "Any gap here = visible hole in schema, not runtime surprise"
  }
}
