  "machine_zone": {
    "description": "AIPOS-F68: Machine-generated fields — derived from schema declarations, advisors cannot hand-edit these. draft_create generates them from schema; draft_publish validates they match current schema derivation.",
    "fields": [
      "draft_status",
      "draft_created_by",
      "draft_created_at",
      "draft_updated_at",
      "draft_publish_target"
    ],
    "body_sections": [
      {
        "section_name": "工作纪律",
        "description": "Work discipline section — generated by machine_zone.derive_machine_zone_纪律段() reading transitions.schema.json N5.branch_integration (branch pattern) + config.schema.json governance_structure.paths (report path)",
        "source": "machine_zone"
      },
      {
        "section_name": "认领与交回",
        "description": "Gate contract section — generated by gate_contract_section.render_gate_contract_section() reading transitions.schema.json N5.branch_integration + config.schema.json governance_structure.paths",
        "source": "gate_contract_section"
      }
    ]
  },
  "advisor_zone": {
    "description": "AIPOS-F68: Advisor judgment fields — machine cannot generate these, require human decision.",
    "fields": [
      "title",
      "output_target",
      "harness",
      "lane",
      "governance_refs",
      "anchor_refs"
