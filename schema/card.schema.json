    },
    "return_record_ref": {
      "type": "string",
      "required": false,
      "description": "Return record reference"
    },
    "return_event_ref": {
      "type": "string",
      "required": false,
      "description": "Return event reference"
    },
    "return_owner_policy_ref": {
      "type": "string",
      "required": false,
