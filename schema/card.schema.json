{
  "schema_version": "1.0.0",
  "description": "Lybra task card schema - single source of truth for all card fields",
  "last_updated": "2026-08-11",
  "fields": {
    "task_id": {
      "type": "string",
      "required": true,
      "description": "Unique task identifier",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "required": true,
      "description": "Task title"
    },
    "project": {
      "type": "string",
      "required": true,
      "description": "Project identifier"
    },
    "assigned_to": {
      "type": "string",
      "required": true,
      "description": "Agent or role assigned to this task"
    },
    "agent_instance": {
      "type": "string",
      "required": false,
      "description": "Specific agent instance identifier"
    },
    "context_bundle": {
      "type": "string",
      "required": true,
      "description": "Context bundle identifier for the task"
    },
    "task_mode": {
      "type": "string",
      "required": true,
      "$enum": "task_mode",
      "description": "Task mode - determines workflow routing (code=full N0-N6; docs/governance/config=skip N4/N5)"
    },
    "task_class": {
      "type": "string",
      "required": false,
      "$enum": "task_class",
      "description": "Task complexity classification"
    },
    "task_type": {
      "type": "string",
      "required": false,
      "$enum": "task_type",
      "description": "Task execution type"
    },
    "model_tier": {
      "type": "string",
      "required": false,
      "description": "Model tier for agent execution"
    },
    "priority": {
      "type": "string",
      "required": true,
      "$enum": "priority",
      "description": "Task priority level"
    },
    "status": {
      "type": "string",
      "required": true,
      "$enum": "queue_state",
      "description": "Current task queue state"
    },
    "created_by": {
      "type": "string",
      "required": true,
      "description": "Creator of the task (agent/role)"
    },
    "created_at": {
      "type": "string",
      "required": false,
      "format": "iso8601",
      "description": "Task creation timestamp"
    },
    "needs_owner": {
      "type": "boolean",
      "required": true,
      "description": "Whether task requires owner approval"
    },
    "needs_owner_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "required": false,
      "description": "Reasons why owner approval is needed"
    },
    "output_target": {
      "type": "string",
      "required": true,
      "description": "Target output location or scope (AIPOS-F78: 存量声明; 车道目录以 lane.paths 为准, output_target 仅作 lane.paths 的派生来源与存量兼容)"
    },
    "harness": {
      "type": "string",
      "required": false,
      "$enum": "harness",
      "description": "AIPOS-F78 件①: 执行引擎声明(pi|codex|claude-code)。缺省由 task_mode 派生, 派生表唯一声明在本文件 intent_face.harness.default_by_task_mode; 渲染器 `lybra card render --harness` 按此选模板"
    },
    "lane": {
      "type": "object",
      "required": false,
      "description": "AIPOS-F78 件①: 车道(子项目即 lane, 不另建功能) {repo: 产品仓(AIPOS-F78C: 仓名或绝对路径, 须在 project.json repos 清单内; 缺省 repos.default/code_repo; 一卡一仓, 跨仓改动拆卡), paths: [允许改动目录/文件前缀], roles: [允许角色类]}。publish 校验: lane 缺失且无法从 output_target 派生 = 拒(LANE_REQUIRED); 交回判据 CHANGES_OUT_OF_SCOPE 读 lane.paths; advisor 可对 claimed 卡受限 amend(restricted_amend)",
      "shape": {
        "repo": "string (AIPOS-F78C: 仓名(project.json repos.items 键)或绝对路径, 须解析到 repos 清单内一项; 无清单时 = code_repo/治理根。一卡一仓; 跨仓改动拆卡, 列表形留待有真实案例。唯一解析: workspace_config.resolve_card_repo)",
        "paths": "array of string (repo-relative dir/file prefixes)",
        "roles": "array of string (role classes allowed to work this lane)"
      }
    },
    "artifact_policy": {
      "type": "string",
      "required": true,
      "$enum": "artifact_policy",
      "description": "Artifact handling policy"
    },
    "artifact_scope": {
      "type": "string",
      "required": false,
      "description": "Scope of artifacts for this task"
    },
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string"},
      "required": false,
      "description": "References to task artifacts"
    },
    "artifact_links": {
      "type": "array",
      "items": {"type": "string"},
      "required": false,
      "description": "Links to task artifacts"
    },
    "session_policy": {
      "type": "string",
      "required": false,
      "description": "Session handling policy"
    },
    "context_isolation": {
      "type": "string",
      "required": false,
      "$enum": "context_isolation",
      "description": "Context isolation level"
    },
    "memory_scope": {
      "type": "string",
      "required": false,
      "description": "Memory scope for task execution"
    },
    "claim_id": {
      "type": "string",
      "required": false,
      "description": "Claim record identifier (runtime field)"
    },
    "claimed_by": {
      "type": "string",
      "required": false,
      "description": "Agent that claimed this task (runtime field)"
    },
    "claimed_at": {
      "type": "string",
      "required": false,
      "format": "iso8601",
      "description": "Claim timestamp (runtime field)"
    },
    "active_session_id": {
      "type": "string",
      "required": false,
      "description": "Active session identifier (runtime field)"
    },
    "active_worktree_path": {
      "type": "string",
      "required": false,
      "description": "Active worktree path for this task (runtime field, AIPOS-R5A)"
    },
    "active_worktree_branch": {
      "type": "string",
      "required": false,
      "description": "Active worktree branch name (runtime field, AIPOS-R5A)"
    },
    "last_session_id": {
      "type": "string",
      "required": false,
      "description": "Last session identifier (runtime field)"
    },
    "session_started_at": {
      "type": "string",
      "required": false,
      "format": "iso8601",
      "description": "Session start timestamp (runtime field)"
    },
    "completed_by": {
      "type": "string",
      "required": false,
      "description": "Agent that completed this task (runtime field)"
    },
    "completed_at": {
      "type": "string",
      "required": false,
      "format": "iso8601",
      "description": "Completion timestamp (runtime field)"
    },
    "closed_at": {
      "type": "string",
      "required": false,
      "format": "iso8601",
      "description": "Closure timestamp (runtime field)"
    },
    "audit": {
      "type": "string",
      "required": false,
      "$enum": "audit_requirement",
      "description": "Audit requirement level"
    },
    "audit_status": {
      "type": "string",
      "required": false,
      "description": "Current audit status (runtime field)"
    },
    "audit_readiness": {
      "type": "string",
      "required": false,
      "description": "Audit readiness state (runtime field)"
    },
    "audit_task_id": {
      "type": "string",
      "required": false,
      "description": "Related audit task identifier"
    },
    "audit_by": {
      "type": "string",
      "required": false,
      "description": "Auditor assignment"
    },
    "audit_dispatch_record_ref": {
      "type": "string",
      "required": false,
      "description": "Audit dispatch record reference"
    },
    "auditor_instance": {
      "type": "string",
      "required": false,
      "description": "Auditor instance identifier"
    },
    "owner_verify": {
      "type": "boolean",
      "required": false,
      "description": "Whether owner verification is required"
    },
    "owner_verify_checklist": {
      "type": "array",
      "items": {"type": "string"},
      "required": false,
      "description": "Owner verification checklist items"
    },
    "owner_verify_preview": {
      "type": "string",
      "required": false,
      "description": "Preview text for owner verification"
    },
    "owner_review_required": {
      "type": "boolean",
      "required": false,
      "description": "Whether owner review is required"
    },
    "owner_approval_ref": {
      "type": "string",
      "required": false,
      "description": "Owner approval record reference"
    },
    "owner_policy_ref": {
      "type": "string",
      "required": false,
      "description": "Owner policy reference"
    },
    "owner_override": {
      "type": "boolean",
      "required": false,
      "description": "Whether owner override is active"
    },
    "owner_confirmation_required": {
      "type": "boolean",
      "required": false,
